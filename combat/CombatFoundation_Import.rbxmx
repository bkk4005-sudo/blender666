<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><External>null</External><External>nil</External><Item class="Folder" referent="null"><Properties><string name="Name">CombatFoundation_Import</string></Properties><Item class="Folder" referent="null"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="null"><Properties><string name="Name">ActionTimeline</string><ProtectedString name="Source">local Config = require(script.Parent.CombatConfig)
local Timeline = {}

function Timeline.phase(actionName, elapsed)
    local action = Config.Actions[actionName]
    if not action or elapsed &lt; 0 or elapsed &gt;= action.duration then return "Ended" end
    if action.active then
        if elapsed &lt; action.active[1] then return "AttackStartup" end
        if elapsed &lt;= action.active[2] then return "AttackActive" end
        return "AttackRecovery"
    end
    if action.iframes then return "Rolling" end
    if action.parry then return "Parrying" end
    if actionName == "Stagger" then return "Staggered" end
    return actionName
end

function Timeline.inWindow(actionName, windowName, elapsed)
    local action = Config.Actions[actionName]
    local window = action and action[windowName]
    return window ~= nil and elapsed &gt;= window[1] and elapsed &lt;= window[2]
end

function Timeline.markers(actionName)
    local action = Config.Actions[actionName]
    if not action then return {} end
    local markers = {{"RecoveryEnd", action.duration}}
    if action.active then
        table.insert(markers, {"AttackStart", 0})
        table.insert(markers, {"HitStart", action.active[1]})
        table.insert(markers, {"HitEnd", action.active[2]})
    end
    if action.combo then
        table.insert(markers, {"ComboOpen", action.combo[1]})
        table.insert(markers, {"ComboClose", action.combo[2]})
    end
    if action.iframes then
        table.insert(markers, {"IFrameStart", action.iframes[1]})
        table.insert(markers, {"IFrameEnd", action.iframes[2]})
    end
    if action.parry then
        table.insert(markers, {"ParryActiveStart", action.parry[1]})
        table.insert(markers, {"ParryActiveEnd", action.parry[2]})
    end
    return markers
end

return Timeline
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">AnimationRegistry</string><ProtectedString name="Source">-- Asset IDs are intentionally empty until the owner publishes and verifies them.
-- Local Studio previews resolve KeyframeSequences through RegisterKeyframeSequence.
local Registry = {}

Registry.Profiles = {
    R15 = {
        CombatIdle = {assetId = nil, source = "combat/assets/animations/r15/combat_idle/CombatIdle.rbxmx", loop = true, priority = Enum.AnimationPriority.Idle},
        SwordR1_1 = {assetId = nil, source = "combat/assets/animations/r15/straight_sword/SwordR1_1.rbxmx", priority = Enum.AnimationPriority.Action},
        SwordR1_2 = {assetId = nil, source = "combat/assets/animations/r15/straight_sword/SwordR1_2.rbxmx", priority = Enum.AnimationPriority.Action},
        SwordR2 = {assetId = nil, source = "combat/assets/animations/r15/straight_sword/SwordR2.rbxmx", priority = Enum.AnimationPriority.Action},
        RollForward = {assetId = nil, source = "combat/assets/animations/r15/dodge/RollForward.rbxmx", status = "ITERATED_REQUIRES_AVATAR_QA", priority = Enum.AnimationPriority.Action4},
        RollBackward = {assetId = nil, source = "combat/assets/animations/r15/dodge/RollBackward.rbxmx", status = "ITERATED_REQUIRES_AVATAR_QA", priority = Enum.AnimationPriority.Action4},
        RollLeft = {assetId = nil, source = "combat/assets/animations/r15/dodge/RollLeft.rbxmx", status = "ITERATED_REQUIRES_AVATAR_QA", priority = Enum.AnimationPriority.Action4},
        RollRight = {assetId = nil, source = "combat/assets/animations/r15/dodge/RollRight.rbxmx", status = "ITERATED_REQUIRES_AVATAR_QA", priority = Enum.AnimationPriority.Action4},
        Block = {assetId = nil, source = "combat/assets/animations/r15/defensive/Block.rbxmx", loop = true, priority = Enum.AnimationPriority.Action},
        Parry = {assetId = nil, source = "combat/assets/animations/r15/defensive/Parry.rbxmx", priority = Enum.AnimationPriority.Action},
        Stagger = {assetId = nil, source = "combat/assets/animations/r15/reactions/Stagger.rbxmx", priority = Enum.AnimationPriority.Action},
        GuardBroken = {assetId = nil, source = "combat/assets/animations/r15/reactions/GuardBroken.rbxmx", priority = Enum.AnimationPriority.Action},
    },
}

function Registry.get(profileName, semanticName)
    local profile = Registry.Profiles[profileName]
    return profile and profile[semanticName]
end

function Registry.registerProfile(profileName, entries)
    assert(type(profileName) == "string" and profileName ~= "", "Profile name required")
    assert(type(entries) == "table", "Profile entries required")
    assert(not Registry.Profiles[profileName], "Profile already registered")
    Registry.Profiles[profileName] = entries
end

return Registry
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">AvatarGroundClearance</string><ProtectedString name="Source">local Visual = require(script.Parent.WeaponVisualConfig)
local Ground = {}
function Ground.floor(cf, size)
    -- Lowest corner of an oriented box, without allocating eight vectors.
    return cf.Position.Y - (math.abs(cf.RightVector.Y) * size.X
        + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z) / 2
end
function Ground.lift(frames, joints, hipHeight, rootSize)
    local floor = -(hipHeight + rootSize.Y / 2)
    local low = math.huge
    for name, joint in joints do
        if frames[name] then low = math.min(low, Ground.floor(frames[name], joint.size)) end
    end
    local sword = frames.RightHand * Visual.HandToHilt * CFrame.new(Visual.SourceGrip.Position * Visual.MeshScale):Inverse()
    low = math.min(low, Ground.floor(sword, Vector3.new(1.51340294, 4.71, .37736732) * Visual.MeshScale))
    return math.max(0, floor + .07 - low)
end
return Ground
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">BladeClearance</string><ProtectedString name="Source">-- Geometry-only arm correction for a baked avatar preview. The weapon remains
-- rigidly attached; lengths, joint offsets, cosmetics and gameplay reach stay fixed.
local Visual = require(script.Parent.WeaponVisualConfig)
local Solver = {}
local order = {"RightUpperArm", "RightLowerArm", "RightHand"}
local body = {"LowerTorso", "UpperTorso", "Head", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg", "LeftUpperArm", "LeftLowerArm", "LeftHand"}
local function intersects(a, b, cf, size)
    a, b = cf:PointToObjectSpace(a), cf:PointToObjectSpace(b)
    local d, lo, hi = b - a, 0, 1
    for _, axis in {"X", "Y", "Z"} do
        local e = size[axis] / 2 + .12
        if math.abs(d[axis]) &lt; 1e-8 then
            if math.abs(a[axis]) &gt; e then return false end
        else
            local x, y = (-e - a[axis]) / d[axis], (e - a[axis]) / d[axis]
            if x &gt; y then x, y = y, x end
            lo, hi = math.max(lo, x), math.min(hi, y)
            if lo &gt; hi then return false end
        end
    end
    return true
end
function Solver.correct(poses, joints, frames, previous, fast)
    local shoulder = joints.RightUpperArm
    local original = poses.RightUpperArm.CFrame
    local originalHand = poses.RightHand.CFrame
    local function handPose(wrist)
        return CFrame.new(originalHand.Position) * CFrame.Angles(0, math.rad(wrist), 0) * originalHand.Rotation
    end
    local function evaluate(yaw, tilt, wrist)
        wrist = wrist or 0
        local rotation = CFrame.Angles(0, math.rad(yaw), math.rad(tilt))
        local cf = CFrame.new(original.Position) * rotation * original.Rotation
        local arm = {}
        for _, name in order do
            local j = joints[name]
            local parent = arm[j.parent] or frames[j.parent]
            local pose = name == "RightUpperArm" and cf or name == "RightHand" and handPose(wrist) or poses[name].CFrame
            arm[name] = parent * j.c0 * pose * j.c1:Inverse()
        end
        local sword = arm.RightHand * Visual.HandToHilt * CFrame.new(Visual.SourceGrip.Position * Visual.MeshScale):Inverse()
        local a = sword:PointToWorldSpace(Vector3.new(0, -.635 * Visual.MeshScale.Y, 0))
        local b = sword:PointToWorldSpace(Vector3.new(0, 2.355 * Visual.MeshScale.Y, 0))
        local collisions = 0
        for _, name in body do if intersects(a, b, frames[name], joints[name].size) then collisions += 1 end end
        local penalty = yaw * yaw + tilt * tilt + 2 * wrist * wrist
        if previous then penalty += 4 * ((yaw - previous.yaw)^2 + (tilt - previous.tilt)^2 + (wrist - (previous.wrist or 0))^2) end
        return collisions * 1e6 + penalty, cf, arm, collisions
    end
    local best, chosen, arm, collisions = evaluate(0, 0)
    local y, t, w = 0, 0, 0
    if collisions == 0 and (not previous or math.abs(previous.yaw) + math.abs(previous.tilt) + math.abs(previous.wrist or 0) &lt; .1) then
        return {yaw = 0, tilt = 0, wrist = 0, unresolved = 0}
    end
    if fast and previous then
        -- Most frames can retain/relax the prior safe correction. Only an
        -- obstructed pose needs the full bounded search.
        for _, factor in {.8, 1} do
            local yaw, tilt = previous.yaw * factor, previous.tilt * factor
            local wrist = (previous.wrist or 0) * factor
            local _, cf, candidateArm, count = evaluate(yaw, tilt, wrist)
            if count == 0 then
                poses.RightUpperArm.CFrame = cf
                poses.RightHand.CFrame = handPose(wrist)
                for name, frame in candidateArm do frames[name] = frame end
                return {yaw = yaw, tilt = tilt, wrist = wrist, unresolved = 0}
            end
        end
    end
    local function consider(yaw, tilt, wrist)
        wrist = wrist or 0
        local score, cf, candidateArm, count = evaluate(yaw, tilt, wrist)
        if score &lt; best then best, chosen, arm, collisions, y, t, w = score, cf, candidateArm, count, yaw, tilt, wrist end
    end
    if previous then consider(previous.yaw, previous.tilt, previous.wrist); consider(previous.yaw * .8, previous.tilt * .8, (previous.wrist or 0) * .8) end
    -- Search small changes first; costs prefer continuity and the authored pose.
    for _, tilt in {0, -10, 10, -20, 20, -30, 30, -45, 45, -60, 60} do
        for _, yaw in {0, -10, 10, -20, 20, -30, 30, -45, 45, -60, 60} do
            consider(yaw, tilt)
        end
    end
    if collisions &gt; 0 then
        -- A bounded wrist deflection handles thick bodies where shoulder-only
        -- correction cannot clear the blade. The hilt stays fixed in the hand.
        for _, wrist in {-15, 15, -30, 30} do
            for _, tilt in {0, -20, 20, -40, 40, -60, 60} do
                for _, yaw in {0, -20, 20, -40, 40, -60, 60} do consider(yaw, tilt, wrist) end
            end
        end
    end
    for _, step in {5, 2.5, 1.25, .625} do
        local cy, ct = y, t
        for _, dy in {-step, 0, step} do
            for _, dt in {-step, 0, step} do
                consider(math.clamp(cy + dy, -60, 60), math.clamp(ct + dt, -60, 60), w)
            end
        end
    end
    poses.RightUpperArm.CFrame = chosen
    poses.RightHand.CFrame = handPose(w)
    for name, cf in arm do frames[name] = cf end
    return {yaw = y, tilt = t, wrist = w, unresolved = collisions}
end
return Solver
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">CombatConfig</string><ProtectedString name="Source">-- Prototype balance values, authored for this project. They are not measured DS3 frames.
local Config = {}

Config.Version = 1
Config.MaxStamina = 100
Config.StaminaRegenPerSecond = 24
Config.StaminaRegenDelay = 0.75
Config.WalkSpeed = 11
Config.SprintSpeed = 17
Config.BlockWalkSpeed = 6
Config.LockRange = 48
Config.TargetLossRange = 58
Config.MaxRequestRate = 16
local function frame(n) return n / 30 end
Config.Actions = {
    SwordR1_1 = {
        duration = frame(28), cost = 18, damage = 22,
        active = {frame(9), frame(14)}, combo = {frame(16), frame(22)}, bufferOpen = frame(11), chainAt = frame(21),
        reach = 7.5, width = 4.2, advance = 2.0, advanceWindow = {frame(4), frame(12)}, turnRate = 90,
    },
    SwordR1_2 = {
        duration = frame(29), cost = 20, damage = 24,
        active = {frame(8), frame(14)}, combo = {frame(16), frame(23)},
        reach = 7.5, width = 4.2, advance = 1.8, advanceWindow = {frame(3), frame(11)}, turnRate = 90,
    },
    SwordR2 = {
        duration = frame(43), cost = 34, damage = 43,
        active = {frame(17), frame(25)}, reach = 8.0, width = 3.8,
        advance = 2.4, advanceWindow = {frame(14), frame(23)}, turnRate = 55,
    },
    RollForward = {duration = frame(25), cost = 27, iframes = {frame(5), frame(16)}, distance = 12},
    RollBackward = {duration = frame(25), cost = 27, iframes = {frame(5), frame(16)}, distance = 11},
    RollLeft = {duration = frame(25), cost = 27, iframes = {frame(5), frame(16)}, distance = 11},
    RollRight = {duration = frame(25), cost = 27, iframes = {frame(5), frame(16)}, distance = 11},
    Parry = {duration = 0.90, cost = 20, parry = {0.18, 0.34}},
    Stagger = {duration = frame(20)},
    GuardBroken = {duration = frame(35)},
}
Config.Block = {absorb = 0.75, staminaPerDamage = 1.1}
Config.SprintDrainPerSecond = 13
Config.HitSampleRate = 30

return table.freeze(Config)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">InputBindings</string><ProtectedString name="Source">-- Client settings contain input names only; they grant no combat authority.
local Bindings = {}
Bindings.Order = {"CombatR1", "CombatR2", "CombatRoll", "CombatBlock", "CombatParry", "CombatSprint", "CombatLock"}
Bindings.Defaults = {CombatR1 = "MouseButton1", CombatR2 = "MouseButton2", CombatRoll = "Space", CombatBlock = "F", CombatParry = "E", CombatSprint = "LeftShift", CombatLock = "Q"}
Bindings.Labels = {CombatR1 = "Лёгкий удар", CombatR2 = "Тяжёлый удар", CombatRoll = "Перекат", CombatBlock = "Блок (удерживать)", CombatParry = "Парирование", CombatSprint = "Спринт (удерживать)", CombatLock = "Фиксация цели"}
local forbidden = {Unknown = true, Escape = true, Backspace = true, Return = true, Tab = true, Slash = true, BackSlash = true, Backquote = true, W = true, A = true, S = true, D = true}
function Bindings.resolve(name)
    if type(name) ~= "string" or #name &gt; 32 or forbidden[name] then return nil end
    if name == "MouseButton1" or name == "MouseButton2" or name == "MouseButton3" then return Enum.UserInputType[name] end
    local ok, value = pcall(function() return Enum.KeyCode[name] end)
    return if ok then value else nil
end
function Bindings.validate(values)
    if type(values) ~= "table" then return nil end
    local result, used = {}, {}
    for _, action in Bindings.Order do
        local name = values[action]
        if not Bindings.resolve(name) or used[name] then return nil end
        result[action], used[name] = name, true
    end
    for key in values do if not Bindings.Defaults[key] then return nil end end
    return result
end
return Bindings
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">R15PreviewRetarget</string><ProtectedString name="Source">-- Studio-only preview bake. Published animations must be approved for their
-- intended RigProfile; this module never changes HumanoidRootPart at runtime.
local RunService = game:GetService("RunService")
local Visual = require(script.Parent.WeaponVisualConfig)
local Clearance = require(script.Parent.BladeClearance)
local Retarget = {}
local names = {"LowerTorso", "UpperTorso", "Head", "LeftUpperArm", "LeftLowerArm",
    "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg",
    "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
local supported = {}
for _, name in names do supported[name] = true end

local function boxFloor(frame: CFrame, size: Vector3): number
    local low = math.huge
    for _, x in {-1, 1} do
        for _, y in {-1, 1} do
            for _, z in {-1, 1} do
                low = math.min(low, frame:PointToWorldSpace(size * Vector3.new(x, y, z) / 2).Y)
            end
        end
    end
    return low
end

local function skeleton(character: Model)
    local joints = {}
    for _, joint in character:GetDescendants() do
        local part0, part1, c0, c1
        if joint:IsA("Motor6D") then
            part0, part1, c0, c1 = joint.Part0, joint.Part1, joint.C0, joint.C1
        elseif joint:IsA("AnimationConstraint") and joint.Attachment0 and joint.Attachment1 then
            part0, part1 = joint.Attachment0.Parent, joint.Attachment1.Parent
            c0, c1 = joint.Attachment0.CFrame, joint.Attachment1.CFrame
        end
        if part0 and part1 and supported[part1.Name] and part1:IsA("BasePart") then
            joints[part1.Name] = {parent = part0.Name, c0 = c0, c1 = c1, size = part1.Size}
        end
    end
    local rest = {HumanoidRootPart = CFrame.new()}
    local ground = math.huge
    for _, name in names do
        local joint = assert(joints[name], "R15 preview joint missing: " .. name)
        rest[name] = assert(rest[joint.parent]) * joint.c0 * joint.c1:Inverse()
        ground = math.min(ground, boxFloor(rest[name], joint.size))
    end
    return joints, ground
end

function Retarget.forCharacter(source: KeyframeSequence, character: Model): KeyframeSequence
    assert(RunService:IsStudio(), "Avatar preview retarget is Studio-only")
    local joints, ground = skeleton(character)
    local sequence = source:Clone()
    -- AuthoredHipHeight cannot be written by a game script (Plugin security).
    -- Compensate the Animator's root translation scaling in the baked poses.
    local height = character:FindFirstChildOfClass("Humanoid").HipHeight
    ground = -(height + character.HumanoidRootPart.Size.Y / 2)
    local metadata = assert(sequence:FindFirstChild("SourceAuthoredHipHeight"), "Authored height metadata missing")
    local translationScale = if height &gt; .01 and metadata.Value &gt; .01
        then height / metadata.Value else 1
    sequence:SetAttribute("PreviewRig", character.Name)
    local keys = sequence:GetKeyframes()
    table.sort(keys, function(a, b) return a.Time &lt; b.Time end)
    local duration = keys[#keys].Time
    local previous, unresolved, maxCorrection = nil, 0, 0
    for _, key in keys do
        local poses = {}
        for _, pose in key:GetDescendants() do
            if pose:IsA("Pose") then poses[pose.Name] = pose end
        end
        local clearance = key:FindFirstChild("SourceGroundClearance")
        assert(clearance and clearance:IsA("NumberValue"), "Source grounding metadata missing")
        local frames = {HumanoidRootPart = CFrame.new()}
        local minimum = math.huge
        for _, name in names do
            local joint, pose = joints[name], assert(poses[name], name)
            -- Canonical R15 export uses identity joint rotation frames.
            local rotation = joint.c0.Rotation:Inverse() * pose.CFrame.Rotation * joint.c1.Rotation
            local position = if name == "LowerTorso"
                then joint.c0.Rotation:VectorToObjectSpace(pose.CFrame.Position) else Vector3.zero
            pose.CFrame = CFrame.new(position) * rotation
            frames[name] = frames[joint.parent] * joint.c0 * pose.CFrame * joint.c1:Inverse()
            minimum = math.min(minimum, boxFloor(frames[name], joint.size))
        end
        previous = Clearance.correct(poses, joints, frames, previous)
        unresolved += previous.unresolved
        maxCorrection = math.max(maxCorrection, math.abs(previous.yaw), math.abs(previous.tilt))
        -- Recompute arm clearance after changing its rotations.
        for _, name in {"RightUpperArm", "RightLowerArm", "RightHand"} do
            minimum = math.min(minimum, boxFloor(frames[name], joints[name].size))
        end
        local swordFrame = frames.RightHand * Visual.HandToHilt
            * CFrame.new(0, 1.195 * Visual.MeshScale.Y, 0)
        local swordSize = Vector3.new(1.51340294, 4.71, 0.37736732) * Visual.MeshScale
        local swordMinimum = boxFloor(swordFrame, swordSize)
        -- Small bounding-box clearance absorbs interpolation and physical
        -- AnimationConstraint settling between the sampled poses.
        -- The inverted root swings body corners between samples. Fade the
        -- extra margin smoothly so the first/last standing poses stay identical.
        local guard = .07
        if source.Name:sub(1, 4) == "Roll" and duration &gt; 0 then
            guard += .17 * math.sin(math.pi * key.Time / duration)^2
        end
        local adjustment = math.max(ground + math.max(clearance.Value, guard) - minimum,
            ground + guard - swordMinimum)
        local rootPose = poses.LowerTorso
        local offset = joints.LowerTorso.c0.Rotation:VectorToObjectSpace(Vector3.new(0, adjustment, 0))
        rootPose.CFrame = CFrame.new((rootPose.CFrame.Position + offset) / translationScale) * rootPose.CFrame.Rotation
    end
    sequence:SetAttribute("UnresolvedBladeSamples", unresolved)
    sequence:SetAttribute("MaximumArmCorrectionDegrees", maxCorrection)
    return sequence
end

return Retarget
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">WeaponVisualConfig</string><ProtectedString name="Source">-- Generated from the Blender hand part frame, not the bone frame.
return {
    MeshId = "rbxassetid://139047510233988",
    MeshScale = Vector3.new(0.62, 0.68, 0.86),
    HandToHilt = CFrame.new(0.0109487, -0.0166222, 0.0070923, -0.57157451, 0.6112116, -0.5474695, -0.5474695, 0.21292061, 0.80928504, 0.61121202, 0.76228935, 0.21291992),
    SourceGrip = CFrame.new(0, -1.195, 0),
