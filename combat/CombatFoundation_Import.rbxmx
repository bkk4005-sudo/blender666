>0.9810496</R22></CoordinateFrame></Properties><Item class="Pose" referent="null"><Properties><string name="Name">RightLowerLeg</string><CoordinateFrame name="CFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>0.99708652</R00><R01>0.01180906</R01><R02>-0.07535928</R02><R10>0.03538033</R10><R11>0.80364609</R11><R12>0.59405494</R12><R20>0.06757741</R20><R21>-0.59499043</R21><R22>0.80088687</R22></CoordinateFrame></Properties><Item class="Pose" referent="null"><Properties><string name="Name">RightFoot</string><CoordinateFrame name="CFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>0.98822141</R00><R01>0.0260745</R01><R02>0.15079342</R02><R10>0.04145272</R10><R11>0.90292746</R11><R12>-0.42778951</R12><R20>-0.14730988</R20><R21>0.42900151</R21><R22>0.89121127</R22></CoordinateFrame></Properties></Item></Item></Item></Item></Item><Item class="KeyframeMarker" referent="null"><Properties><string name="Name">RecoveryEnd</string><string name="Value" /></Properties></Item></Item></Item></Item><Item class="Folder" referent="null"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="null"><Properties><string name="Name">BladeTrajectory</string><ProtectedString name="Source">-- Server-owned authored blade path. Never reads client joint Transform,
-- AnimationTrack time, hit reports or damage requests.
local Shared = game.ReplicatedStorage.CombatFoundation.Shared
local Retarget = require(Shared.R15PreviewRetarget)
local Visual = require(Shared.WeaponVisualConfig)
local Trajectory = {}
local order = {"LowerTorso", "UpperTorso", "Head", "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot"}

function Trajectory.build(character, source, yieldEvery)
    local joints = {}
    for _, joint in character:GetDescendants() do
        if joint:IsA("Motor6D") then
            local p0,p1=joint.Part0,joint.Part1
            if p0 and p1 then joints[p1.Name]={parent=p0.Name,c0=joint.C0,c1=joint.C1} end
        elseif joint:IsA("AnimationConstraint") and joint.Attachment0 and joint.Attachment1 then
            local a0,a1=joint.Attachment0,joint.Attachment1
            joints[a1.Parent.Name]={parent=a0.Parent.Name,c0=a0.CFrame,c1=a1.CFrame}
        end
    end
    for _, name in order do assert(joints[name], "Blade trajectory requires R15 joint "..name) end
    local sequence = Retarget.bakeForRig(source, character, yieldEvery)
    local height = sequence.SourceAuthoredHipHeight.Value
    local scale = height&gt;.01 and character.Humanoid.HipHeight/height or 1
    local grip = Visual.forCharacter(character) * CFrame.new(Visual.SourceGrip.Position*Visual.MeshScale):Inverse()
    local samples={}
    local keys=sequence:GetKeyframes()
    table.sort(keys,function(a,b) return a.Time&lt;b.Time end)
    for _, key in keys do
        local poses={}
        for _, item in key:GetDescendants() do if item:IsA("Pose") then poses[item.Name]=item.CFrame end end
        local frames={HumanoidRootPart=CFrame.new()}
        for _, name in order do
            local j, pose = joints[name], poses[name]
            if name=="LowerTorso" then pose=CFrame.new(pose.Position*scale)*pose.Rotation end
            frames[name]=frames[j.parent]*j.c0*pose*j.c1:Inverse()
        end
        local sword=frames.RightHand*grip
        table.insert(samples,{time=key.Time,
            base=sword:PointToWorldSpace(Vector3.new(0,-.635*Visual.MeshScale.Y,0)),
            tip=sword:PointToWorldSpace(Vector3.new(0,2.355*Visual.MeshScale.Y,0))})
    end
    sequence:Destroy()
    return samples
end

function Trajectory.sample(samples,time)
    if time&lt;=samples[1].time then return samples[1].base,samples[1].tip end
    if time&gt;=samples[#samples].time then return samples[#samples].base,samples[#samples].tip end
    local lo,hi=1,#samples
    while hi-lo&gt;1 do
        local mid=math.floor((lo+hi)/2)
        if samples[mid].time&lt;=time then lo=mid else hi=mid end
    end
    local a,b=samples[lo],samples[hi]
    local alpha=(time-a.time)/(b.time-a.time)
    return a.base:Lerp(b.base,alpha),a.tip:Lerp(b.tip,alpha)
end

local function intersection(a,b,cf,size,radius)
    a,b=cf:PointToObjectSpace(a),cf:PointToObjectSpace(b)
    local d,lo,hi=b-a,0,1
    for _, axis in {"X","Y","Z"} do
        local e=size[axis]/2+radius
        if math.abs(d[axis])&lt;1e-8 then
            if math.abs(a[axis])&gt;e then return nil end
        else
            local x,y=(-e-a[axis])/d[axis],(e-a[axis])/d[axis]
            if x&gt;y then x,y=y,x end
            lo,hi=math.max(lo,x),math.min(hi,y)
            if lo&gt;hi then return nil end
        end
    end
    return cf:PointToWorldSpace(a+d*lo)
end

function Trajectory.query(character,a,b,previousA,previousB,radius)
    previousA,previousB=previousA or a,previousB or b
    local low=Vector3.new(math.min(a.X,b.X,previousA.X,previousB.X),math.min(a.Y,b.Y,previousA.Y,previousB.Y),math.min(a.Z,b.Z,previousA.Z,previousB.Z))
    local high=Vector3.new(math.max(a.X,b.X,previousA.X,previousB.X),math.max(a.Y,b.Y,previousA.Y,previousB.Y),math.max(a.Z,b.Z,previousA.Z,previousB.Z))
    local params=OverlapParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character}
    local found={}
    local midA,midB=previousA:Lerp(a,.5),previousB:Lerp(b,.5)
    -- Tip travel is a swept contact test, but visibility still originates at
    -- the blade base. A zero-length tip sample inside a body must not bypass
    -- cover by tracing only from the character root directly to that tip.
    local segments={{a,b},{previousA,previousB},{midA,midB},{previousA,a},{previousB,b,previousA}}
    for _, part in workspace:GetPartBoundsInBox(CFrame.new((low+high)/2),high-low+Vector3.one*(radius*2),params) do
        -- Ignore accessories, weapons and invisible root collision proxies.
        local model=part.Parent
        if not model or not model:IsA("Model") or part.Name=="HumanoidRootPart" then continue end
        local humanoid=model:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health&gt;0 then
            for _, segment in segments do
                local contact=intersection(segment[1],segment[2],part.CFrame,part.Size,radius)
                if contact then
                    found[humanoid]=found[humanoid] or {}
                    table.insert(found[humanoid],{part=part,origin=segment[3] or segment[1],contact=contact})
                end
            end
        end
    end
    return found
end
return Trajectory
</ProtectedString></Properties></Item><Item class="Script" referent="null"><Properties><string name="Name">CombatBootstrap</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")

local root = ReplicatedStorage:WaitForChild("CombatFoundation")
local remote = root:FindFirstChild("CombatRemote")
if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "CombatRemote"
    remote.Parent = root
end

local service = require(script.Parent:WaitForChild("CombatService")).new(remote)
script.Destroying:Connect(function() service:destroy() end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="null"><Properties><string name="Name">CombatService</string><ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CombatFoundation"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("CombatConfig"))
local Timeline = require(Shared:WaitForChild("ActionTimeline"))
local BladeTrajectory = require(script.Parent:WaitForChild("BladeTrajectory"))

local CombatService = {}
CombatService.__index = CombatService

local ROLL_DIRECTIONS = {RollForward = true, RollBackward = true, RollLeft = true, RollRight = true}
local ATTACKS = {SwordR1_1 = true, SwordR1_2 = true, SwordR2 = true}

local function living(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return humanoid and humanoid.Health &gt; 0 and root and humanoid, root
end

local function horizontalUnit(vector)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    return flat.Magnitude &gt; 1e-4 and flat.Unit or Vector3.new(0, 0, -1)
end

local function planarMotion(root, name, maxForce)
    local attachment = Instance.new("Attachment")
    attachment.Name = name .. "Attachment"
    attachment.Parent = root
    local velocity = Instance.new("LinearVelocity")
    velocity.Name = name .. "Velocity"
    velocity.Attachment0 = attachment
    velocity.MaxForce = maxForce
    velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
    velocity.PrimaryTangentAxis = Vector3.xAxis
    velocity.SecondaryTangentAxis = Vector3.zAxis
    velocity.PlaneVelocity = Vector2.zero
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.Parent = root
    return attachment, velocity
end

local function velocityFactor(progress)
    return math.max(0, math.min(progress / 0.15, 1, (1 - progress) / 0.25))
end

function CombatService.new(remote)
    local self = setmetatable({remote = remote, profiles = {}, connections = {}}, CombatService)
    table.insert(self.connections, remote.OnServerEvent:Connect(function(player, request)
        self:request(player, request)
    end))
    table.insert(self.connections, Players.PlayerAdded:Connect(function(player)
        self:bindPlayer(player)
    end))
    table.insert(self.connections, Players.PlayerRemoving:Connect(function(player)
        self:removePlayer(player)
    end))
    for _, player in Players:GetPlayers() do self:bindPlayer(player) end
    local accumulator = 0
    table.insert(self.connections, RunService.Heartbeat:Connect(function(dt)
        accumulator += math.min(dt, 0.1)
        local step = 1 / Config.HitSampleRate
        while accumulator &gt;= step do
            accumulator -= step
            self:update(step)
        end
    end))
    return self
end

function CombatService:bindPlayer(player)
    if self.profiles[player] then return end
    local profile = {
        player = player, character = nil, action = nil, started = 0,
        stamina = Config.MaxStamina, lastSpend = 0, lastSequence = 0,
        rateWindow = 0, rateCount = 0, hit = {}, comboQueued = false,
        sweepTime = nil, motionVelocity = nil, motionAttachment = nil, motionDirection = nil,
        facing = nil,
        alive = false, blocking = false, sprinting = false,
        characterConnections = {},
    }
    self.profiles[player] = profile
    profile.playerConnection = player.CharacterAdded:Connect(function(character)
        self:bindCharacter(profile, character)
    end)
    profile.appearanceConnection = player.CharacterAppearanceLoaded:Connect(function(character)
        if profile.character == character then self:prepareBladePaths(profile, character) end
    end)
    if player.Character then self:bindCharacter(profile, player.Character) end
end

function CombatService:bindCharacter(profile, character)
    self:clearCharacter(profile)
    profile.character = character
    profile.bladeCache = {}
    local humanoid = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not root then return end
    profile.alive = humanoid.Health &gt; 0
    profile.stamina = Config.MaxStamina
    profile.lastSpend = 0
    profile.blocking = false
    profile.sprinting = false
    profile.action = nil
    profile.hit = {}
    humanoid.WalkSpeed = Config.WalkSpeed
    character:SetAttribute("CombatState", "Idle")
    character:SetAttribute("Stamina", profile.stamina)
    character:SetAttribute("MaxStamina", Config.MaxStamina)
    table.insert(profile.characterConnections, humanoid.Died:Connect(function()
        profile.alive = false
        self:finish(profile)
        character:SetAttribute("CombatState", "Dead")
    end))
    if typeof(profile.player) == "Instance" and profile.player:IsA("Player") and profile.player:HasAppearanceLoaded() then
        self:prepareBladePaths(profile, character)
    end
end

function CombatService:prepareBladePaths(profile, character)
    profile.bladeGeneration = (profile.bladeGeneration or 0) + 1
    local generation = profile.bladeGeneration
    profile.bladeCache = {}
    character:SetAttribute("CombatHitReady", false)
    task.spawn(function()
        for _, name in {"SwordR1_1", "SwordR1_2", "SwordR2"} do
            if profile.character ~= character or profile.bladeGeneration ~= generation or not profile.alive then return end
            local source = ReplicatedStorage.CombatFoundation.Animations:FindFirstChild(name)
            local ok, path = pcall(BladeTrajectory.build, character, source, 8)
            if profile.character ~= character or profile.bladeGeneration ~= generation or not profile.alive then return end
            if not ok then character:SetAttribute("CombatHitRigError", tostring(path)); return end
            profile.bladeCache[name] = path
        end
        character:SetAttribute("CombatHitRigError", nil)
        character:SetAttribute("CombatHitReady", true)
    end)
end

function CombatService:clearCharacter(profile)
    profile.bladeGeneration = (profile.bladeGeneration or 0) + 1
    for _, connection in profile.characterConnections do connection:Disconnect() end
    table.clear(profile.characterConnections)
    self:finish(profile)
    profile.character = nil
end

function CombatService:removePlayer(player)
    local profile = self.profiles[player]
    if not profile then return end
    self:clearCharacter(profile)
    if profile.playerConnection then profile.playerConnection:Disconnect() end
    if profile.appearanceConnection then profile.appearanceConnection:Disconnect() end
    self.profiles[player] = nil
end

function CombatService:setState(profile, state)
    local character = profile.character
    if character and character:GetAttribute("CombatState") ~= state then
        character:SetAttribute("CombatState", state)
    end
end

function CombatService:spend(profile, amount, now)
    if profile.stamina + 1e-4 &lt; amount then return false end
    profile.stamina = math.max(0, profile.stamina - amount)
    profile.lastSpend = now
    profile.character:SetAttribute("Stamina", profile.stamina)
    return true
end

function CombatService:finish(profile)
    if profile.motionVelocity then profile.motionVelocity:Destroy(); profile.motionVelocity = nil end
    if profile.motionAttachment then profile.motionAttachment:Destroy(); profile.motionAttachment = nil end
    profile.motionDirection = nil
    profile.facing = nil
    profile.action = nil
    profile.comboQueued = false
    profile.comboSequence = nil
    profile.sweepTime = nil
    profile.sweepRoot = nil
    profile.hit = {}
    local humanoid = profile.character and profile.character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health &gt; 0 then
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = profile.blocking and Config.BlockWalkSpeed or Config.WalkSpeed
        self:setState(profile, profile.blocking and "Blocking" or "Idle")
    end
end

function CombatService:broadcastStarted(profile, actionName, now, requestSequence)
    profile.actionSerial = (profile.actionSerial or 0) + 1
    self.remote:FireAllClients("Started", profile.player, actionName, now,
        {character = profile.character, serial = profile.actionSerial, sequence = requestSequence})
end

function CombatService:start(profile, actionName, now, rollVector, requestSequence)
    local action = Config.Actions[actionName]
    if not action or not profile.alive or profile.action then return false end
    if type(now) ~= "number" or now ~= now or math.abs(now) == math.huge then return false end
    local humanoid, root = living(profile.character)
    if not humanoid or not root:IsA("BasePart") then return false end
    if ATTACKS[actionName] and typeof(profile.player) == "Instance" and profile.player:IsA("Player")
        and profile.character:GetAttribute("CombatHitReady") ~= true then return false end
    if rollVector ~= nil then
        if not ROLL_DIRECTIONS[actionName] or typeof(rollVector) ~= "Vector3" then return false end
        for _, component in {rollVector.X, rollVector.Y, rollVector.Z} do
            if component ~= component or math.abs(component) == math.huge then return false end
        end
        local flat = Vector3.new(rollVector.X, 0, rollVector.Z)
        if flat.Magnitude &lt; 0.8 or flat.Magnitude &gt; 1.2 then return false end
        rollVector = flat.Unit
    end
    if not self:spend(profile, action.cost or 0, now) then return false end
    profile.action = actionName
    profile.started = now
    profile.comboQueued = false
    profile.hit = {}
    profile.sweepTime = nil
    profile.blocking = false
    profile.sprinting = false
    humanoid.WalkSpeed = 0
    humanoid.AutoRotate = false
    self:setState(profile, Timeline.phase(actionName, 0))
    if ATTACKS[actionName] then
        profile.facing = horizontalUnit(root.CFrame.LookVector)
        profile.sweepTime = 0
        profile.sweepRoot = CFrame.lookAt(root.Position, root.Position + profile.facing)
        profile.motionDirection = profile.facing
        profile.motionAttachment, profile.motionVelocity = planarMotion(root, "CombatAdvance", 22000)
    end
    if ROLL_DIRECTIONS[actionName] then
        local direction
        if actionName == "RollBackward" then direction = -root.CFrame.LookVector
        elseif actionName == "RollLeft" then direction = -root.CFrame.RightVector
        elseif actionName == "RollRight" then direction = root.CFrame.RightVector
        else direction = root.CFrame.LookVector end
        profile.motionAttachment, profile.motionVelocity = planarMotion(root, "CombatRoll", 35000)
        profile.motionDirection = horizontalUnit(rollVector or direction)
    end
    self:broadcastStarted(profile, actionName, now, requestSequence)
    return true
end

function CombatService:request(player, request)
    local profile = self.profiles[player]
    if not profile or not profile.alive or type(request) ~= "table" then return end
    local sequence = request.sequence
    if type(sequence) ~= "number" or sequence ~= sequence or math.abs(sequence) == math.huge
        or sequence % 1 ~= 0 or sequence &lt;= profile.lastSequence then return end
    if sequence &gt; profile.lastSequence + 100 then return end
    profile.lastSequence = sequence
    local now = workspace:GetServerTimeNow()
    if now - profile.rateWindow &gt;= 1 then profile.rateWindow, profile.rateCount = now, 0 end
    profile.rateCount += 1
    -- Releasing a held control must remain possible after a burst. These two
    -- idempotent requests cannot start actions, deal damage or spend stamina.
    local release = request.kind == "BlockEnd" or request.kind == "SprintEnd"
    if profile.rateCount &gt; Config.MaxRequestRate and not release then
        if request.kind == "R1" or request.kind == "R2" or request.kind == "Roll" or request.kind == "Parry"
            or request.kind == "BlockStart" or request.kind == "SprintStart" then
            self.remote:FireClient(player, "Rejected", sequence)
        end
        return
    end
    local humanoid, root = living(profile.character)
    if not humanoid or not root:IsA("BasePart") then return end
    local kind = request.kind
    if type(kind) ~= "string" then return end
    local function rejected() self.remote:FireClient(player, "Rejected", sequence) end
    if kind == "R1" then
        if profile.action == "SwordR1_1" and now - profile.started &gt;= Config.Actions.SwordR1_1.bufferOpen and now - profile.started &lt;= Config.Actions.SwordR1_1.combo[2] then
            if profile.stamina + 1e-4 &lt; Config.Actions.SwordR1_2.cost then rejected(); return end
            profile.comboQueued = true
            profile.comboSequence = sequence
            return
        end
        if profile.action or profile.blocking or not self:start(profile, "SwordR1_1", now, nil, sequence) then rejected() end
    elseif kind == "R2" then
        if profile.action or profile.blocking or not self:start(profile, "SwordR2", now, nil, sequence) then rejected() end
    elseif kind == "Roll" then
        local name = request.direction
        if not profile.action and not profile.blocking and ROLL_DIRECTIONS[name] then
            local vector = request.moveDirection
            if vector ~= nil then
                if typeof(vector) ~= "Vector3" then return end
                for _, component in {vector.X, vector.Y, vector.Z} do
                    if component ~= component or math.abs(component) == math.huge then return end
                end
                local flat = Vector3.new(vector.X, 0, vector.Z)
                if flat.Magnitude &lt; 0.8 or flat.Magnitude &gt; 1.2 then return end
                local expected
                if name == "RollBackward" then expected = -root.CFrame.LookVector
                elseif name == "RollLeft" then expected = -root.CFrame.RightVector
                elseif name == "RollRight" then expected = root.CFrame.RightVector
                else expected = root.CFrame.LookVector end
                if horizontalUnit(expected):Dot(flat.Unit) &lt; 0.5 then return end
                vector = flat.Unit
            end
            if not self:start(profile, name, now, vector, sequence) then rejected() end
        else
            rejected()
        end
    elseif kind == "BlockStart" then
        if not profile.action and profile.stamina &gt; 0 then
            profile.sprinting = false
            profile.blocking = true
            humanoid.WalkSpeed = Config.BlockWalkSpeed
            self:setState(profile, "Blocking")
        end
    elseif kind == "BlockEnd" then
        profile.blocking = false
        if not profile.action then
            humanoid.WalkSpeed = profile.sprinting and Config.SprintSpeed or Config.WalkSpeed
            self:setState(profile, profile.sprinting and "Sprinting" or "Idle")
        end
    elseif kind == "Parry" then
        if profile.action or profile.blocking or not self:start(profile, "Parry", now, nil, sequence) then rejected() end
    elseif kind == "SprintStart" then
        if not profile.action and not profile.blocking and profile.stamina &gt; 0 then profile.sprinting = true; humanoid.WalkSpeed = Config.SprintSpeed end
    elseif kind == "SprintEnd" then
        profile.sprinting = false
        if not profile.action then humanoid.WalkSpeed = profile.blocking and Config.BlockWalkSpeed or Config.WalkSpeed end
    end
end

function CombatService:profileForCharacter(character)
    local player = Players:GetPlayerFromCharacter(character)
    return player and self.profiles[player]
end

local function applyHealthDamage(targetHumanoid, damage)
    local character = targetHumanoid.Parent
    if character:GetAttribute("CombatDummy") == true then
        damage = math.min(damage, math.max(0, targetHumanoid.Health - 1))
    end
    targetHumanoid:TakeDamage(damage)
    if character:GetAttribute("CombatDummy") == true then
        local serial = (character:GetAttribute("CombatDummyHitSerial") or 0) + 1
        character:SetAttribute("CombatDummyHitSerial", serial)
        task.delay(1.5, function()
            if targetHumanoid.Parent == character and targetHumanoid.Health &gt; 0
                and character:GetAttribute("CombatDummyHitSerial") == serial then
                targetHumanoid.Health = targetHumanoid.MaxHealth
            end
        end)
    end
end

function CombatService:damage(attacker, targetHumanoid, actionName, now)
    local character = targetHumanoid.Parent
    if character == attacker.character or targetHumanoid.Health &lt;= 0 then return false end
    local defender = self:profileForCharacter(character)
    if defender and defender.alive then
        local elapsed = now - defender.started
        if defender.action and Timeline.inWindow(defender.action, "iframes", elapsed) then return false end
        local attackerRoot = attacker.character:FindFirstChild("HumanoidRootPart")
        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        local facing = false
        if attackerRoot and targetRoot then
            local displacement = attackerRoot.Position - targetRoot.Position
            facing = displacement.Magnitude &gt; 0 and targetRoot.CFrame.LookVector:Dot(displacement.Unit) &gt; 0.25
        end
        if defender.action == "Parry" and Timeline.inWindow("Parry", "parry", elapsed) and facing then
            self:finish(attacker)
            local staggerHumanoid = attacker.character and attacker.character:FindFirstChildOfClass("Humanoid")
            if staggerHumanoid and staggerHumanoid.Health &gt; 0 then
                attacker.action = "Stagger"
                attacker.started = now
                staggerHumanoid.WalkSpeed = 0
                self:setState(attacker, "Staggered")
                self:broadcastStarted(attacker, "Stagger", now)
            else
                -- A validated same-frame trade can be parried after its actor
                -- died. Deny that hit without resurrecting a reaction state.
                self:setState(attacker, "Dead")
            end
            return true
        end
        if defender.blocking and facing then
            local action = Config.Actions[actionName]
            local drain = action.damage * Config.Block.staminaPerDamage
            local paid = self:spend(defender, drain, now)
            if paid then
                applyHealthDamage(targetHumanoid, action.damage * (1 - Config.Block.absorb))
                return true
            end
            defender.blocking = false
            defender.stamina = 0
            defender.lastSpend = now
            character:SetAttribute("Stamina", 0)
            self:finish(defender)
            defender.action = "GuardBroken"
            defender.started = now
            targetHumanoid.WalkSpeed = 0
            self:setState(defender, "GuardBroken")
            self:broadcastStarted(defender, "GuardBroken", now)
        end
    end
    applyHealthDamage(targetHumanoid, Config.Actions[actionName].damage)
    return true
end

function CombatService:bladePath(profile, actionName)
    profile.bladeCache = profile.bladeCache or {}
    if profile.bladeCache[actionName] then return profile.bladeCache[actionName] end
    local source = ReplicatedStorage.CombatFoundation.Animations:FindFirstChild(actionName)
    if not source then return nil end
    local ok, path = pcall(BladeTrajectory.build, profile.character, source)
    if not ok then
        profile.character:SetAttribute("CombatHitRigError", tostring(path))
        return nil -- Unsupported/missing joints fail closed, never use a broad fallback.
    end
    profile.bladeCache[actionName] = path
    return path
end

function CombatService:sweep(profile, actionName, elapsed, now, frameHits)
    local action = Config.Actions[actionName]
    local humanoid, root = living(profile.character)
    if not humanoid then return end
    if profile.action ~= actionName then return end
    local old = profile.sweepTime or 0
    if elapsed &lt;= old or old &gt;= action.active[2] then return end
    local facing = profile.facing or horizontalUnit(root.CFrame.LookVector)
    local currentRoot = CFrame.lookAt(root.Position,root.Position+facing)
    local previousRoot = profile.sweepRoot or currentRoot
    -- A discontinuous root jump must not produce a damage ribbon through the map.
    if (currentRoot.Position-previousRoot.Position).Magnitude&gt;2 then previousRoot=currentRoot end
    profile.sweepTime,profile.sweepRoot=elapsed,currentRoot
    local from,to=math.max(old,action.active[1]),math.min(elapsed,action.active[2])
    if from&gt;to then return end
    local path = self:bladePath(profile, actionName)
    if not path then return end
    local hitSet = profile.hit
    local pendingTargets
    if frameHits then
        pendingTargets = frameHits.pendingTargets[hitSet]
        if not pendingTargets then
            pendingTargets = {}
            frameHits.pendingTargets[hitSet] = pendingTargets
        end
    end
    local count = math.clamp(math.ceil((to-from)*60),1,32)
    local previousA,previousB
    for index=0,count do
        local alpha=index/count
        local time=from+(to-from)*alpha
        local frame=previousRoot:Lerp(currentRoot,(time-old)/(elapsed-old))
        local localA,localB=BladeTrajectory.sample(path,time)
        local a,b=frame:PointToWorldSpace(localA),frame:PointToWorldSpace(localB)
        for target, contacts in BladeTrajectory.query(profile.character,a,b,previousA,previousB,.18) do
            if hitSet[target] or (pendingTargets and pendingTargets[target]) then continue end
            local model=target.Parent
            local targetRoot=model:FindFirstChild("HumanoidRootPart")
            if not targetRoot or (targetRoot.Position-root.Position).Magnitude&gt;action.reach+2 then continue end
            local ray=RaycastParams.new()
            ray.FilterType=Enum.RaycastFilterType.Exclude
            ray.FilterDescendantsInstances={profile.character,model}
            ray.RespectCanCollide=true
            for _, candidate in contacts do
                -- Use the actual segment/box intersection. A ray to a torso's
                -- centre can clear low cover while the blade hits through it.
                local origin,contact=candidate.origin,candidate.contact
                local bodyObstruction=workspace:Raycast(frame.Position,origin-frame.Position,ray)
                local bladeObstruction=workspace:Raycast(origin,contact-origin,ray)
                if not bodyObstruction and not bladeObstruction then
                    if frameHits then
                        -- Geometry for this action was validated while its actor
                        -- was alive. Defer damage until every actor has swept.
                        pendingTargets[target] = true
                        table.insert(frameHits.pendingHits, {profile = profile,
                            character = profile.character, action = actionName,
                            started = profile.started, hitSet = hitSet,
                            target = target, targetCharacter = model})
                        break
                    elseif self:damage(profile,target,actionName,now) then
                        hitSet[target] = true
                        if profile.action~=actionName then return end
                        break
                    end
                end
            end
        end
        previousA,previousB=a,b
    end
end

local function resolveFrameHits(service, frameHits, now)
    local killedCharacters, cancelledActions = {}, {}
    for _, intent in frameHits.pendingHits do
        local profile, character, hitSet = intent.profile, intent.character, intent.hitSet
        if cancelledActions[hitSet] or hitSet[intent.target]
            or profile.character ~= character or not character.Parent
            or intent.target.Parent ~= intent.targetCharacter or not intent.targetCharacter.Parent then continue end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local alive = profile.alive and humanoid and humanoid.Health &gt; 0
        local killedHere = killedCharacters[character] == true
        -- Died may have already called finish() and replaced the live hitSet.
        -- Only a death caused by this resolution permits that captured trade;
        -- parry/guard break or a different action never permit stale intents.
        local unchanged = profile.action == intent.action and profile.hit == hitSet
        local finishedByDeath = killedHere and profile.action == nil
        if not humanoid or (not alive and not killedHere)
            or profile.started ~= intent.started or (not unchanged and not finishedByDeath) then continue end
        local actionBefore, hitsBefore, startedBefore = profile.action, profile.hit, profile.started
        local healthBefore = intent.target.Health
        if service:damage(profile, intent.target, intent.action, now) then
            hitSet[intent.target] = true
        end
        if healthBefore &gt; 0 and intent.target.Health &lt;= 0 then
            killedCharacters[intent.targetCharacter] = true
        end
        -- A parry can invalidate every remaining contact from the same sweep.
        -- Mark the captured action even if another hit subsequently kills it.
        if profile.action ~= actionBefore or profile.hit ~= hitsBefore or profile.started ~= startedBefore then
            cancelledActions[hitSet] = true
        end
    end
end

function CombatService:update(dt)
    local now = workspace:GetServerTimeNow()
    local frameHits = {pendingHits = {}, pendingTargets = {}}
    local frameActors = {}
    -- First collect contacts for all living actors, before any of their hits
    -- can kill the actor visited next in the profiles table.
    for _, profile in self.profiles do
        if not profile.alive then continue end
        local humanoid = living(profile.character)
        if not humanoid then continue end
        if profile.sprinting and not profile.action then
            local drain = Config.SprintDrainPerSecond * dt
            if profile.stamina &lt;= drain then
                profile.sprinting = false
                humanoid.WalkSpeed = Config.WalkSpeed
            else
                profile.stamina -= drain
                profile.lastSpend = now
            end
        elseif not profile.action and now - profile.lastSpend &gt;= Config.StaminaRegenDelay then
            profile.stamina = math.min(Config.MaxStamina, profile.stamina + Config.StaminaRegenPerSecond * dt)
        end
        profile.character:SetAttribute("Stamina", math.floor(profile.stamina * 10 + 0.5) / 10)
        local actor = {profile = profile, character = profile.character,
            action = profile.action, started = profile.started}
        table.insert(frameActors, actor)
        if profile.action then
            local actionName = profile.action
            local action = Config.Actions[actionName]
            local elapsed = now - profile.started
            actor.elapsed = elapsed
            if not action then continue end
            if ATTACKS[actionName] and profile.facing then
                local _, root = living(profile.character)
                if root then
                    local wanted = horizontalUnit(root.CFrame.LookVector)
                    local current = profile.facing
                    local signedAngle = math.atan2(current.Z * wanted.X - current.X * wanted.Z, current:Dot(wanted))
                    local maxTurn = math.rad(action.turnRate) * dt
                    local step = math.clamp(signedAngle, -maxTurn, maxTurn)
                    profile.facing = CFrame.Angles(0, step, 0):VectorToWorldSpace(current)
                    profile.motionDirection = profile.facing
                end
            end
            if profile.motionVelocity and profile.motionDirection then
                local window = ROLL_DIRECTIONS[actionName] and action.motionWindow or action.advanceWindow
                if window then
                    local span = window[2] - window[1]
                    local progress = math.clamp((elapsed - window[1]) / span, 0, 1)
                    local distance = ROLL_DIRECTIONS[actionName] and action.distance or action.advance
                    local speed = distance / span / 0.80 * velocityFactor(progress)
                    if elapsed &lt; window[1] or elapsed &gt; window[2] then speed = 0 end
                    local horizontal = profile.motionDirection * speed
                    profile.motionVelocity.PlaneVelocity = Vector2.new(horizontal.X, horizontal.Z)
                end
            end
            if ATTACKS[actionName] then
                self:sweep(profile, actionName, elapsed, now, frameHits)
            end
        end
    end
    resolveFrameHits(self, frameHits, now)
    -- Resolve contacts before advancing combos or ending recovery. Reactions
    -- raised by resolution retain their state and cannot chain the old attack.
    for _, actor in frameActors do
        local profile = actor.profile
        if profile.character ~= actor.character or not profile.alive then continue end
        local humanoid = living(profile.character)
        if not humanoid then continue end
        if profile.action ~= actor.action or profile.started ~= actor.started then continue end
        if profile.action then
            local actionName, elapsed = actor.action, actor.elapsed
            local action = Config.Actions[actionName]
            if actionName == "SwordR1_1" and profile.comboQueued and elapsed &gt;= action.chainAt then
                local comboSequence = profile.comboSequence
                self:finish(profile)
                self:start(profile, "SwordR1_2", now, nil, comboSequence)
                continue
            end
            if action then
                self:setState(profile, Timeline.phase(actionName, elapsed))
                if elapsed &gt;= action.duration then
                    self:finish(profile)
                end
            else
                self:finish(profile)
            end
        elseif profile.blocking then
            self:setState(profile, "Blocking")
        elseif profile.sprinting then
            self:setState(profile, "Sprinting")
        else
            self:setState(profile, humanoid.MoveDirection.Magnitude &gt; 0.05 and "Moving" or "Idle")
        end
    end
end

function CombatService:destroy()
    for _, connection in self.connections do connection:Disconnect() end
    for player in self.profiles do self:removePlayer(player) end
end

return CombatService
</ProtectedString></Properties></Item><Item class="Script" referent="null"><Properties><string name="Name">CombatSettings</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local root = ReplicatedStorage:WaitForChild("CombatFoundation")
local Bindings = require(root.Shared:WaitForChild("InputBindings"))
local remote = root:FindFirstChild("CombatSettingsRemote") or Instance.new("RemoteEvent")
remote.Name, remote.Parent = "CombatSettingsRemote", root
local storeOk, store = pcall(function() return DataStoreService:GetDataStore("CombatInputBindings_v1") end)
if not storeOk then store = nil end
local sessions = {}
local function save(player, session)
    if session.saving or not session.dirty then return end
    session.saving = true
    local snapshot, version = table.clone(session.values), session.version
    local ok = store ~= nil and pcall(function() store:UpdateAsync(tostring(player.UserId), function() return snapshot end) end)
    session.saving = false
    if ok and session.version == version then session.dirty = false end
    if player.Parent then
        if not ok then remote:FireClient(player, "Unavailable")
        elseif session.version == version then remote:FireClient(player, "Saved") end
    end
    if ok and session.dirty then task.defer(save, player, session) end
end
remote.OnServerEvent:Connect(function(player, kind, values)
    if kind ~= "Load" and kind ~= "Save" then return end
    local session = sessions[player]
    if not session then session = {values = table.clone(Bindings.Defaults), version = 0, dirty = false, nextRequest = 0}; sessions[player] = session end
    local now = os.clock()
    if now &lt; session.nextRequest then return end
    session.nextRequest = now + .2
    if kind == "Load" then
        if session.loading or session.loaded then return end
        session.loading = true
        local version = session.version
        local ok, stored = false, nil
        if store then ok, stored = pcall(function() return store:GetAsync(tostring(player.UserId)) end) end
        session.loading, session.loaded = false, true
        if session.version == version then session.values = Bindings.validate(stored) or session.values end
        if player.Parent then
            remote:FireClient(player, "Loaded", session.values)
            if not ok then remote:FireClient(player, "Unavailable") end
        end
    else
        local valid = Bindings.validate(values)
        if not valid then return end
        session.values, session.version, session.dirty = valid, session.version + 1, true
        -- Coalesce edits; datastore calls run independently of combat.
        if session.scheduled then return end
        session.scheduled = true
        task.delay(3, function()
            session.scheduled = false
            save(player, session)
        end)
    end
end)
Players.PlayerRemoving:Connect(function(player)
    local session = sessions[player]
    if session then
        local deadline = os.clock() + 8
        while session.saving and os.clock() &lt; deadline do task.wait(.1) end
        save(player, session)
    end
    sessions[player] = nil
end)
game:BindToClose(function()
    for player, session in sessions do task.spawn(save, player, session) end
    local deadline = os.clock() + 8
    repeat
        local pending = false
        for _, session in sessions do if session.saving then pending = true end end
        if not pending then break end
        task.wait(.1)
    until os.clock() &gt;= deadline
end)
</ProtectedString></Properties></Item><Item class="Script" referent="null"><Properties><string name="Name">WeaponVisual</string><ProtectedString name="Source">-- Server-created rigid visual. No damage or reach is derived from its mesh.
-- The registered unscaled template lives in ServerStorage/CombatWeaponTemplates.
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local foundation = ReplicatedStorage:WaitForChild("CombatFoundation", 8)
if not foundation then warn("CombatTestSword: CombatFoundation missing"); return end
local Visual = require(foundation:WaitForChild("Shared"):WaitForChild("WeaponVisualConfig"))

local function getTemplate(): Model?
    local templates = ServerStorage:FindFirstChild("CombatWeaponTemplates")
    local registered = templates and templates:FindFirstChild("StraightSword")
    if registered and registered:IsA("Model") then return registered end
    local direct = ServerStorage:FindFirstChild("CombatTestSwordTemplate")
    if direct and direct:IsA("Model") then return direct end
    return nil
end

local function attach(character: Model, player: Player)
    local deadline = os.clock() + 12
    while player.Character == character and not player:HasAppearanceLoaded() and os.clock() &lt; deadline do task.wait(.1) end
    if player.Character ~= character then return end
    -- A slow appearance must not equip onto hands that Roblox will replace.
    -- CharacterAppearanceLoaded retries when those assets finally arrive.
    if not player:HasAppearanceLoaded() then return end
    local hand = character:WaitForChild("RightHand", 8)
    local template = getTemplate()
    if not hand or not hand:IsA("BasePart") or not template then
        warn("CombatTestSword: R15 RightHand or sword template unavailable")
        return
    end
    local existing = character:FindFirstChild("CombatTestSword")
    local previousGrip = hand:FindFirstChild("CombatTestSwordGrip")
    if existing and previousGrip and previousGrip:IsA("Motor6D")
        and previousGrip.Part0 == hand and previousGrip.Part1
        and previousGrip.Part1:IsDescendantOf(existing) then return end
    if existing then existing:Destroy() end
    local oldGrip = hand:FindFirstChild("CombatTestSwordGrip")
    if oldGrip then oldGrip:Destroy() end

    local swordModel = template:Clone()
    swordModel.Name = "CombatTestSword"
    local blade = swordModel:FindFirstChildWhichIsA("MeshPart", true)
    if not blade then
        swordModel:Destroy()
        warn("CombatTestSword: sword template has no MeshPart")
        return
    end
    -- This weapon profile has one rigid mesh. Reject incompatible templates
    -- rather than leave additional unconnected parts floating in the scene.
    for _, item in swordModel:GetDescendants() do
        if item:IsA("BasePart") and item ~= blade then
            swordModel:Destroy()
            warn("Combat weapon template requires a single MeshPart")
            return
        end
    end
    local originalGrip = blade:FindFirstChild("RightGrip")
    if not originalGrip or not originalGrip:IsA("Attachment") then
        -- The standalone source mesh has no attachments; its R15 donor copy
        -- records the handle at this point relative to the mesh centre.
        originalGrip = Instance.new("Attachment")
        originalGrip.Name = "RightGrip"
        originalGrip.CFrame = Visual.SourceGrip
        originalGrip.Parent = blade
    end
    blade.Size = blade.Size * Visual.MeshScale
    for _, child in blade:GetChildren() do
        if child:IsA("Attachment") then
            child.Position = child.Position * Visual.MeshScale
        end
    end
    blade.Anchored = false
    blade.CanCollide = false
    blade.CanTouch = false
    blade.CanQuery = false
    blade.Massless = true
    local grip = Instance.new("Motor6D")
    grip.Name = "CombatTestSwordGrip"
    grip.Part0 = hand
    grip.Part1 = blade
    grip.C0 = Visual.forCharacter(character) * originalGrip.CFrame:Inverse()
    grip.C1 = CFrame.new()
    blade.CFrame = hand.CFrame * grip.C0
    grip.Parent = hand
    swordModel.Parent = character
end

local function onPlayer(player: Player)
    player.CharacterAdded:Connect(function(character) attach(character, player) end)
    player.CharacterAppearanceLoaded:Connect(function(character) attach(character, player) end)
    if player.Character then task.defer(attach, player.Character, player) end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do onPlayer(player) end
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="null"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="null"><Properties><string name="Name">AvatarWeaponClearance</string><ProtectedString name="Source">-- Runs for every visible equipped avatar, so corrections are rendered by each
-- observer. Joint Transform is evaluated after Animator, per Roblox guidance.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local root = game.ReplicatedStorage:WaitForChild("CombatFoundation")
local Solver = require(root.Shared:WaitForChild("BladeClearance"))
local Ground = require(root.Shared:WaitForChild("AvatarGroundClearance"))
local Visual = require(root.Shared:WaitForChild("WeaponVisualConfig"))
local order = {"LowerTorso", "UpperTorso", "Head", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
local models = {}
local function register(character)
    if models[character] then return end
    local pending = {ready = false}
    models[character] = pending
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 8)
        local hand = character:WaitForChild("RightHand", 8)
        if models[character] ~= pending then return end
        if not humanoid or not hand then models[character] = nil; return end
        -- Weapon appears only after the server completes appearance application.
        local sword = character:WaitForChild("CombatTestSword", 12)
        if models[character] ~= pending then return end
        if not sword or not character.Parent then models[character] = nil; return end
        local joints = {}
        for _, joint in character:GetDescendants() do
            if joint:IsA("Motor6D") or joint:IsA("AnimationConstraint") then
                local p0, p1 = joint.Part0, joint.Part1
                if p0 and p1 then joints[p1.Name] = {parent = p0.Name, c0 = joint.C0, c1 = joint.C1, size = p1.Size, instance = joint} end
            end
        end
        for _, name in order do if not joints[name] then models[character] = nil; return end end
        pending.joints, pending.humanoid, pending.ready = joints, humanoid, true
    end)
end
local function watch(player)
    player.CharacterAdded:Connect(register)
    player.CharacterAppearanceLoaded:Connect(function(character)
        models[character] = nil
        register(character)
    end)
    player.CharacterRemoving:Connect(function(character) models[character] = nil end)
    if player.Character then register(player.Character) end
end
Players.PlayerAdded:Connect(watch)
for _, player in Players:GetPlayers() do watch(player) end
RunService.PreAnimation:Connect(function()
    -- Remove our last overlay before Animator evaluates, including paused tracks.
    for character, data in models do
        if not character.Parent then models[character] = nil
        elseif data.ready and data.raw then
            local joint = data.joints.RightUpperArm.instance
            if joint.Parent then joint.Transform = data.raw end
            if data.rawWrist and data.joints.RightHand.instance.Parent then data.joints.RightHand.instance.Transform = data.rawWrist end
            if data.rawRoot and data.joints.LowerTorso.instance.Parent then data.joints.LowerTorso.instance.Transform = data.rawRoot end
            data.raw = nil
            data.rawWrist = nil
            data.rawRoot = nil
        end
    end
end)
RunService.PreSimulation:Connect(function()
    for character, data in models do
        if not data.ready or data.humanoid.Health &lt;= 0 then continue end
        local animator = data.humanoid:FindFirstChildOfClass("Animator")
        if not animator or animator.EvaluationThrottled then continue end
        if not character:FindFirstChild("CombatTestSword") then continue end
        local frames, poses = {HumanoidRootPart = CFrame.new()}, {}
        local valid = true
        for _, name in order do
            local j = data.joints[name]
            if not j.instance.Parent then valid = false; break end
            j.c0, j.c1 = j.instance.C0, j.instance.C1
            j.size = character[name].Size
            poses[name] = {CFrame = j.instance.Transform}
            frames[name] = frames[j.parent] * j.c0 * poses[name].CFrame * j.c1:Inverse()
        end
        if not valid then models[character] = nil; continue end
        local original = poses.RightUpperArm.CFrame
        local originalWrist = poses.RightHand.CFrame
        local handToHilt = Visual.forCharacter(character)
        data.previous = Solver.correct(poses, data.joints, frames, data.previous, true, handToHilt)
        data.raw = original
        data.rawWrist = originalWrist
        data.joints.RightUpperArm.instance.Transform = poses.RightUpperArm.CFrame
        data.joints.RightHand.instance.Transform = poses.RightHand.CFrame
        local state = character:GetAttribute("CombatState")
        if state ~= "Idle" and state ~= "Moving" and state ~= "Sprinting" and state ~= "Dead" then
            local lift = Ground.lift(frames, data.joints, data.humanoid.HipHeight, character.HumanoidRootPart.Size, handToHilt)
            local j = data.joints.LowerTorso
            data.rawRoot = j.instance.Transform
            local offset = j.c0.Rotation:VectorToObjectSpace(Vector3.new(0, lift, 0))
            j.instance.Transform = CFrame.new(data.rawRoot.Position + offset) * data.rawRoot.Rotation
        end
        if character:GetAttribute("VisualBladeUnresolved") ~= data.previous.unresolved then
            character:SetAttribute("VisualBladeUnresolved", data.previous.unresolved)
        end
    end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="null"><Properties><string name="Name">CombatClient</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local player = Players.LocalPlayer
local rootFolder = ReplicatedStorage:WaitForChild("CombatFoundation")
local shared = rootFolder:WaitForChild("Shared")
local Config = require(shared:WaitForChild("CombatConfig"))
local Registry = require(shared:WaitForChild("AnimationRegistry"))
local Bindings = require(shared:WaitForChild("InputBindings"))
local PreviewRetarget = require(shared:WaitForChild("R15PreviewRetarget"))
local Observer = require(shared:WaitForChild("CombatObserver"))
local remote = rootFolder:WaitForChild("CombatRemote")
local sources = rootFolder:WaitForChild("Animations")

local character, humanoid, root, animator
local tracks = {}
local previewSequences = {}
local trackConnections = {}
local predicted = nil
local actionTrack = nil
local target = nil
local occludedSince = nil
local facingAttachment = nil
local facingAlign = nil
local inputSequence = 0
local moveVector = Vector3.zero
local camera = workspace.CurrentCamera
local controls = nil
local lastPosition = nil
local deathConnection = nil
local characterVersion = 0
local localAction = nil
local comboSubmitted = false
local firstR1Input = nil
local comboBuffer = nil
local comboRequest = nil
local confirmedAction = nil
local lastAcceptedSerial = 0
local learnedAckRTT = .25
local destroyed = false
local movementSuppressed = false
local lifetimeConnections = {}
local function connectLifetime(signal, callback)
    local connection = signal:Connect(function(...)
        if not destroyed then callback(...) end
    end)
    table.insert(lifetimeConnections, connection)
    return connection
end
local observer = Observer.new(rootFolder, function(count)
    if not destroyed and script.Parent then script:SetAttribute("ObserverAnimationCount", count) end
end)

local function rolling()
    return character and (character:GetAttribute("CombatState") == "Rolling"
        or (localAction and localAction.name:sub(1, 4) == "Roll" and os.clock() &lt; localAction.ends))
end

local function canStart()
    if not character or predicted or rolling() then return false end
    local state = character:GetAttribute("CombatState")
    return (state == "Idle" or state == "Moving" or state == "Sprinting")
        and (not localAction or os.clock() &gt;= localAction.ends)
end

local function releasePredictedMovement()
    if movementSuppressed and humanoid and humanoid.Parent and humanoid.Health &gt; 0 then
        local state = character and character:GetAttribute("CombatState")
        if state == "Idle" or state == "Moving" or state == "Sprinting" or state == "Blocking" then
            humanoid.WalkSpeed = state == "Blocking" and Config.BlockWalkSpeed
                or state == "Sprinting" and Config.SprintSpeed or Config.WalkSpeed
            humanoid.AutoRotate = target == nil
        end
    end
    movementSuppressed = false
    if script.Parent then script:SetAttribute("MovementPredictionSuppressed", false) end
end

local function predictMovementRestriction()
    if not humanoid or humanoid.Health &lt;= 0 then return end
    local localBusy = localAction and os.clock() &lt; localAction.ends
    local state = character and character:GetAttribute("CombatState")
    local serverFree = state == "Idle" or state == "Moving" or state == "Sprinting" or state == "Blocking"
    if localBusy or (movementSuppressed and not serverFree) then
        if not movementSuppressed then
            movementSuppressed = true
            script:SetAttribute("MovementPredictionSuppressed", true)
        end
        -- Match the server's action restriction on the first input frame.
        -- PlayerModule remains active; its walking intent cannot propel a
        -- predicted wind-up/roll while the server response is in transit.
        humanoid.WalkSpeed = 0
        humanoid.AutoRotate = false
        humanoid:Move(Vector3.zero, false)
    elseif movementSuppressed then
        releasePredictedMovement()
    end
end

local function disconnectTracks()
    releasePredictedMovement()
    for _, connection in trackConnections do connection:Disconnect() end
    table.clear(trackConnections)
    for _, track in tracks do track:Stop(0); track:Destroy() end
    table.clear(tracks)
    for _, sequence in previewSequences do sequence:Destroy() end
    table.clear(previewSequences)
    actionTrack = nil
    predicted = nil
    localAction = nil
    comboSubmitted = false
    firstR1Input, comboBuffer, comboRequest = nil, nil, nil
    confirmedAction = nil
end

local function loadTrack(semantic)
    if tracks[semantic] then return tracks[semantic] end
    local entry = Registry.get("R15", semantic)
    if not entry or not animator then return nil end
    local assetId = entry.assetId
    if not assetId and RunService:IsStudio() then
        local sequence = sources:FindFirstChild(semantic)
        if sequence and sequence:IsA("KeyframeSequence") then
            local ok, temporaryId = pcall(function()
                local preview = PreviewRetarget.forCharacter(sequence, character)
                table.insert(previewSequences, preview)
                return KeyframeSequenceProvider:RegisterKeyframeSequence(preview)
            end)
            if ok then assetId = temporaryId end
            if not ok then warn("Combat preview retarget failed:", semantic, temporaryId) end
        end
    end
    if not assetId then return nil end
    local animation = Instance.new("Animation")
    animation.Name = semantic
    animation.AnimationId = assetId
    local ok, track = pcall(function() return animator:LoadAnimation(animation) end)
    animation:Destroy()
    if not ok then warn("Combat animation failed:", semantic, track); return nil end
    track.Name = semantic
    track.Priority = entry.priority
    track.Looped = entry.loop == true
    tracks[semantic] = track
    local lastReached = {}
    local markers = {"AttackStart", "HitStart", "HitEnd", "ComboOpen", "ComboClose", "RecoveryEnd", "IFrameStart", "IFrameEnd", "FootstepLeft", "FootstepRight", "ParryActiveStart", "ParryActiveEnd"}
    for _, marker in markers do
        table.insert(trackConnections, track:GetMarkerReachedSignal(marker):Connect(function()
            local now = os.clock()
            local previous = lastReached[marker]
            if previous and now - previous.at &lt; 1 / 15
                and math.abs(track.TimePosition - previous.position) &lt; 1 / 120 then return end
            lastReached[marker] = {at = now, position = track.TimePosition}
            -- Observable for sound/VFX integration only. Combat authority stays on server.
            if script.Parent then
                script:SetAttribute("LastAnimationMarker", semantic .. ":" .. marker)
                script:SetAttribute("AnimationCueSerial", (script:GetAttribute("AnimationCueSerial") or 0) + 1)
            end
        end))
    end
    return track
end

local function playAction(semantic, restart)
    local track = loadTrack(semantic)
    if not track then return nil end
    local isRoll = semantic:sub(1, 4) == "Roll"
    if isRoll then
        -- Full-body exclusive track: remove residual combat weights at takeoff.
        for name, other in tracks do if name ~= semantic and name ~= "CombatIdle" then other:Stop(.035) end end
        track.Priority = Enum.AnimationPriority.Action4
    elseif actionTrack and actionTrack ~= track then
        actionTrack:Stop(actionTrack.Name:sub(1, 4) == "Roll" and .035 or .12)
    end
    actionTrack = track
    if restart or not track.IsPlaying then track:Play(isRoll and .035 or .10, 1, 1) end
    return track
end

local function phaseDiagnostic(state, elapsed, track, mode)
    if not script.Parent then return end
    script:SetAttribute("ConfirmedActionSerial", state.serial)
    script:SetAttribute("AnimationServerElapsed", elapsed)
    script:SetAttribute("AnimationPhaseError", elapsed - track.TimePosition)
    script:SetAttribute("AnimationPhaseCorrection", mode)
end

local function alignConfirmed(state)
    local action = Config.Actions[state.name]
    if not action then return end
    local elapsed = math.max(0, workspace:GetServerTimeNow() - state.started)
    local track = state.track
    local isRoll = state.name:sub(1, 4) == "Roll"
    if elapsed &gt;= action.duration then
        -- A roll can finish its remaining rise instead of being truncated when
        -- clock correction leaves the presentation slightly behind the server.
        if isRoll and track and track.IsPlaying and track.TimePosition &lt; action.duration - .02
            and elapsed &lt; action.duration + .35 then
            track:AdjustSpeed(1.35)
            localAction = {name = state.name, serial = state.serial,
                ends = os.clock() + math.min(.35, (action.duration - track.TimePosition) / 1.35 + .03)}
            phaseDiagnostic(state, elapsed, track, "RollFinish")
            return
        end
        if track and track.IsPlaying and actionTrack == track then track:Stop(isRoll and .035 or .08) end
        if localAction and localAction.serial == state.serial then localAction = nil end
        if confirmedAction == state then confirmedAction = nil end
        return
    end
    if not track then
        track = playAction(state.name, true)
        state.track, state.seekInitial = track, true
    end
    if not track then return end
    if state.finished then
        phaseDiagnostic(state, elapsed, track, "NaturalEnd")
        return
    end
    if not track.IsPlaying then
        -- Animator can finish one frame before the smoothed server clock.
        -- Replaying that final frame emits a second AnimationPlayed event.
        -- Keep the server input deadline while letting the ended clip fade;
        -- unexpected stops earlier in the action still recover below.
        if action.duration - elapsed &lt;= 1 / 30 then
            state.finished = true
            phaseDiagnostic(state, elapsed, track, "NaturalEnd")
            return
        end
        track:Play(isRoll and .035 or .10, 1, 1)
        state.seekInitial = true
    end
    -- New authoritative clips start at their present phase. Matching an active
    -- prediction keeps its pose and slows an ahead track instead of rewinding.
    local error = elapsed - track.TimePosition
    if track.Length &gt; 0 and (state.seekInitial or error &gt; .20) then
        track.TimePosition = math.min(elapsed, track.Length)
        state.seekInitial = false
        track:AdjustSpeed(1)
        phaseDiagnostic(state, elapsed, track, "ForwardAlign")
    else
        local speed = math.abs(error) &lt;= .025 and 1 or math.clamp(1 + error * 6, .35, 1.35)
        if error &lt; -.35 then speed = 0 end
        track:AdjustSpeed(speed)
        phaseDiagnostic(state, elapsed, track, speed == 1 and "Aligned" or speed &lt; 1 and "SlowAhead" or "CatchUp")
    end
end

local function send(kind, direction, predictedName, moveDirection)
    if destroyed then return end
    if predictedName then
        local action = Config.Actions[predictedName]
        local stamina = character and character:GetAttribute("Stamina")
        if action and action.cost and type(stamina) == "number" and stamina &lt; action.cost then return end
    end
    inputSequence += 1
    script:SetAttribute("LastInputRequest", kind)
    local sentServer = workspace:GetServerTimeNow()
    remote:FireServer({kind = kind, direction = direction, moveDirection = moveDirection, sequence = inputSequence})
    if predictedName then
        -- canStart has already admitted this new action. An expired tracker
        -- must not later stop a reused AnimationTrack during its new request.
        confirmedAction = nil
        local action = Config.Actions[predictedName]
        local now = os.clock()
        predicted = {name = predictedName, sequence = inputSequence, sent = now, sentServer = sentServer,
            deadline = now + math.max((action and action.duration or 0) + .5, learnedAckRTT * 2 + .5)}
        localAction = {name = predictedName, ends = os.clock() + (action and action.duration or .38)}
        predictMovementRestriction()
        predicted.localAction = localAction
        comboSubmitted = false
        comboBuffer, comboRequest = nil, nil
        firstR1Input = predictedName == "SwordR1_1" and {
            sequence = inputSequence, sentServer = sentServer, character = character, version = characterVersion,
        } or nil
        predicted.track = playAction(predictedName, true)
        script:SetAttribute("PredictionStatus", "Pending")
    end
    return inputSequence
end

local function dispatchCombo()
    local queued = comboBuffer
    if not queued then return end
    local first, action = firstR1Input, Config.Actions.SwordR1_1
    local now = workspace:GetServerTimeNow()
    if player:GetAttribute("CombatSettingsOpen") or UserInputService:GetFocusedTextBox()
        or not first or first.character ~= character or first.version ~= characterVersion
        or first.sequence ~= queued.firstSequence or not localAction or localAction.name ~= "SwordR1_1"
        or now &gt; queued.expires or now - first.sentServer &gt; action.combo[2] then
        comboBuffer = nil
        script:SetAttribute("ComboInputStatus", "Expired")
        return
    end
    -- Both native requests traverse the same link. Their expected receipt
    -- interval is their send interval, including before the first ack arrives.
    -- This estimate schedules input only; the server still checks its window.
    local receiptPhase = now - first.sentServer
    if receiptPhase &lt; action.bufferOpen + 1 / Config.HitSampleRate then return end
    comboBuffer = nil
    local sequence = send("R1")
    if not sequence then return end
    comboSubmitted = true
    comboRequest = {sequence = sequence, firstSequence = first.sequence,
        character = character, version = characterVersion}
    script:SetAttribute("ComboInputStatus", "Submitted")
    script:SetAttribute("ComboRequestSequence", sequence)
    script:SetAttribute("ComboEstimatedReceiptPhase", receiptPhase)
end

local function bufferCombo()
    if comboSubmitted or comboBuffer or not firstR1Input then return end
    local action = Config.Actions.SwordR1_1
    local now = workspace:GetServerTimeNow()
    if now - firstR1Input.sentServer &gt; action.combo[2] then return end
    comboBuffer = {firstSequence = firstR1Input.sequence,
        expires = now + math.min(.20, action.combo[2] - action.bufferOpen)}
    script:SetAttribute("ComboInputStatus", "Buffered")
    dispatchCombo()
end

connectLifetime(RunService.PreAnimation, function(dt)
    local pending = predicted
    if not pending or not pending.track or pending.track ~= actionTrack then return end
    if confirmedAction and confirmedAction.track == pending.track then return end
    local action = Config.Actions[pending.name]
    -- Roll presentation always completes. Unconfirmed sword contact waits at
    -- the end of anticipation; markers never grant damage or invulnerability.
    if not action or not action.active or not pending.track.IsPlaying then return end
    local holdAt = math.max(0, action.active[1] - 1 / 30)
    local remaining = holdAt - pending.track.TimePosition
    pending.track:AdjustSpeed(math.clamp(remaining / math.max(dt, 1 / 240), 0, 1))
end)

local function validTarget(model)
    if model == character or not model:IsA("Model") then return false end
    local enemyHumanoid = model:FindFirstChildOfClass("Humanoid")
    local enemyRoot = model:FindFirstChild("HumanoidRootPart")
    if not enemyHumanoid or enemyHumanoid.Health &lt;= 0 or not enemyRoot or not root then return false end
    local distance = (enemyRoot.Position - root.Position).Magnitude
    if distance &gt; Config.LockRange then return false end
    local direction = enemyRoot.Position - camera.CFrame.Position
    if camera.CFrame.LookVector:Dot(direction.Unit) &lt; 0.25 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local ray = workspace:Raycast(camera.CFrame.Position, direction, params)
    return not ray or ray.Instance:IsDescendantOf(model)
end

local function targetVisible(model)
    local enemyRoot = model:FindFirstChild("HumanoidRootPart")
    if not enemyRoot then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local ray = workspace:Raycast(camera.CFrame.Position, enemyRoot.Position - camera.CFrame.Position, params)
    return not ray or ray.Instance:IsDescendantOf(model)
end

local function chooseTarget()
    local best, bestScore = nil, math.huge
    for _, model in workspace:GetDescendants() do
        if model:IsA("Model") and validTarget(model) then
            local enemyRoot = model.HumanoidRootPart
            local offset = enemyRoot.Position - root.Position
            local direction = offset.Unit
            local score = offset.Magnitude + (1 - camera.CFrame.LookVector:Dot(direction)) * 18
            if score &lt; bestScore then best, bestScore = model, score end
        end
    end
    return best
end

local function clearFacing()
    if facingAlign then facingAlign:Destroy(); facingAlign = nil end
    if facingAttachment then facingAttachment:Destroy(); facingAttachment = nil end
    if humanoid and humanoid.Health &gt; 0 then humanoid.AutoRotate = true end
end

local function ensureFacing()
    if facingAlign or not root then return end
    facingAttachment = Instance.new("Attachment")
    facingAttachment.Name = "CombatLockFacing"
    facingAttachment.Parent = root
    facingAlign = Instance.new("AlignOrientation")
    facingAlign.Name = "CombatLockFacing"
    facingAlign.Attachment0 = facingAttachment
    facingAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
    facingAlign.Responsiveness = 8
    facingAlign.MaxTorque = 18000
    facingAlign.MaxAngularVelocity = math.rad(180)
    facingAlign.Parent = root
end

local function setLock(newTarget)
    target = newTarget
    occludedSince = nil
    if not target then
        clearFacing()
        camera.CameraType = Enum.CameraType.Custom
        return
    end
    ensureFacing()
    camera.CameraType = Enum.CameraType.Scriptable
end

local function rollDirection()
    local f = (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
    local r = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
    if not root then return "RollForward", Vector3.new(0, 0, -1) end
    if f == 0 and r == 0 then return "RollForward", Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit end
    local cameraForward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
    local cameraRight = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)
    local forward = cameraForward.Magnitude &gt; 1e-4 and cameraForward.Unit or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
    local right = cameraRight.Magnitude &gt; 1e-4 and cameraRight.Unit or Vector3.new(root.CFrame.RightVector.X, 0, root.CFrame.RightVector.Z).Unit
    local world = forward * f + right * r
    if world.Magnitude &lt; 1e-4 then world = root.CFrame.LookVector end
    world = Vector3.new(world.X, 0, world.Z).Unit
    local forwardScore = world:Dot(root.CFrame.LookVector)
    local rightScore = world:Dot(root.CFrame.RightVector)
    if math.abs(rightScore) &gt; math.abs(forwardScore) then
        return rightScore &gt; 0 and "RollRight" or "RollLeft", world
    end
    return forwardScore &lt; 0 and "RollBackward" or "RollForward", world
end

local function bindCharacter(newCharacter)
    if destroyed then return end
    characterVersion += 1
    local version = characterVersion
    if deathConnection then deathConnection:Disconnect(); deathConnection = nil end
    disconnectTracks()
    script:SetAttribute("PreviewAnimationCount", 0)
    setLock(nil)
    character = newCharacter
    humanoid, root, animator = nil, nil, nil
    -- Appearance application can rebuild the joints/Animator after CharacterAdded.
    -- Preview geometry and tracks must be cached on the completed avatar.
    local deadline = os.clock() + 8
    while not destroyed and player.Character == newCharacter and not player:HasAppearanceLoaded()
        and os.clock() &lt; deadline do RunService.Heartbeat:Wait() end
    if destroyed or version ~= characterVersion or player.Character ~= newCharacter then return end
    local nextHumanoid = newCharacter:WaitForChild("Humanoid", 8)
    local nextRoot = newCharacter:WaitForChild("HumanoidRootPart", 8)
    if destroyed or version ~= characterVersion or player.Character ~= newCharacter or not nextHumanoid or not nextRoot then return end
    local nextAnimator = nextHumanoid:FindFirstChildOfClass("Animator") or nextHumanoid:WaitForChild("Animator", 8)
    if destroyed or version ~= characterVersion or player.Character ~= newCharacter or not nextAnimator then return end
    humanoid, root, animator = nextHumanoid, nextRoot, nextAnimator
    table.insert(trackConnections, animator.AnimationPlayed:Connect(function(track)
        if rolling() and track ~= actionTrack and track.Priority ~= Enum.AnimationPriority.Core
            and track.Priority.Value &gt;= Enum.AnimationPriority.Action.Value then track:Stop(0) end
    end))
    moveVector = Vector3.zero
    lastPosition = root.Position
    for name in Registry.Profiles.R15 do loadTrack(name) end
    local idle = tracks.CombatIdle
    if idle then
        idle.Priority = Enum.AnimationPriority.Movement
        idle:Play(0.20)
    end
    local count = 0
    for _ in tracks do count += 1 end
    script:SetAttribute("PreviewAnimationCount", count)
    deathConnection = humanoid.Died:Connect(function()
        if character == newCharacter then
            disconnectTracks()
            setLock(nil)
        end
    end)
end

local function handleInput(actionName, inputState, inputObject)
    if destroyed then return Enum.ContextActionResult.Pass end
    script:SetAttribute("LastBoundInput", actionName .. ":" .. inputState.Name)
    -- Held actions must release even if chat/menu focus changed after Begin.
    if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
        if actionName == "CombatBlock" then send("BlockEnd"); return Enum.ContextActionResult.Sink end
        if actionName == "CombatSprint" then send("SprintEnd"); return Enum.ContextActionResult.Sink end
    end
    if player:GetAttribute("CombatSettingsOpen") then return Enum.ContextActionResult.Sink end
    if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
    if not humanoid or humanoid.Health &lt;= 0 then return Enum.ContextActionResult.Sink end
    if rolling() and actionName ~= "CombatLock" then return Enum.ContextActionResult.Sink end
    if actionName == "CombatR1" and inputState == Enum.UserInputState.Begin then
        if localAction and os.clock() &lt; localAction.ends and localAction.name == "SwordR1_1" then
            bufferCombo() -- Only the server's Started event switches clips.
        elseif canStart() then send("R1", nil, "SwordR1_1") end
    elseif actionName == "CombatR2" and inputState == Enum.UserInputState.Begin then
        if canStart() then send("R2", nil, "SwordR2") end
    elseif actionName == "CombatRoll" and inputState == Enum.UserInputState.Begin then
        local name, worldDirection = rollDirection()
        if canStart() then send("Roll", name, name, worldDirection) end
    elseif actionName == "CombatBlock" then
        if inputState == Enum.UserInputState.Begin and canStart() then send("BlockStart")
        elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then send("BlockEnd") end
    elseif actionName == "CombatParry" and inputState == Enum.UserInputState.Begin then
        if canStart() then send("Parry", nil, "Parry") end
    elseif actionName == "CombatSprint" then
        if inputState == Enum.UserInputState.Begin and canStart() then send("SprintStart")
        elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then send("SprintEnd") end
    elseif actionName == "CombatLock" and inputState == Enum.UserInputState.Begin then
        setLock(target and nil or chooseTarget())
    end
    return Enum.ContextActionResult.Sink
end

local function bindAction(action)
    if destroyed then return end
    if action == "CombatBlock" then send("BlockEnd") end
    if action == "CombatSprint" then send("SprintEnd") end
    ContextActionService:UnbindAction(action)
    local key = Bindings.resolve(player:GetAttribute("Binding_" .. action)) or Bindings.resolve(Bindings.Defaults[action])
    ContextActionService:BindActionAtPriority(action, handleInput, false, Enum.ContextActionPriority.High.Value + 1, key)
end
for _, action in Bindings.Order do
    bindAction(action)
    connectLifetime(player:GetAttributeChangedSignal("Binding_" .. action), function() bindAction(action) end)
end
connectLifetime(player:GetAttributeChangedSignal("CombatSettingsOpen"), function()
    if player:GetAttribute("CombatSettingsOpen") then
        comboBuffer = nil
        send("BlockEnd")
        send("SprintEnd")
    end
end)
local function releaseHeldActions()
    if destroyed then return end
    comboBuffer = nil
    send("BlockEnd")
    send("SprintEnd")
end
connectLifetime(UserInputService.WindowFocusReleased, releaseHeldActions)
connectLifetime(UserInputService.TextBoxFocused, releaseHeldActions)

connectLifetime(remote.OnClientEvent, function(kind, owner, semantic, started, metadata)
    if kind == "Rejected" and comboRequest and owner == comboRequest.sequence then
        if comboRequest.character == character and comboRequest.version == characterVersion
            and firstR1Input and comboRequest.firstSequence == firstR1Input.sequence then
            comboSubmitted = false
            script:SetAttribute("ComboInputStatus", "Rejected")
        end
        comboRequest = nil
        return -- A rejected continuation must never stop the first swing.
    end
    if kind == "Rejected" and predicted and owner == predicted.sequence then
        local pending = predicted
        if pending.track and (not confirmedAction or confirmedAction.track ~= pending.track) then pending.track:Stop(.08) end
        if localAction == pending.localAction then localAction = nil end
        predicted = nil
        comboSubmitted = false
        firstR1Input, comboBuffer, comboRequest = nil, nil, nil
        script:SetAttribute("PredictionStatus", "Rejected")
        predictMovementRestriction()
        return
    end
    if kind ~= "Started" then return end
    if owner ~= player then
        observer:started(owner, semantic, started, metadata)
        return
    end
    if type(metadata) ~= "table" or metadata.character ~= character or metadata.character ~= player.Character then return end
    local serial = metadata.serial
    if type(serial) ~= "number" or serial ~= serial or serial % 1 ~= 0
        or math.abs(serial) == math.huge or serial &lt;= lastAcceptedSerial then return end
    if type(started) ~= "number" or started ~= started or math.abs(started) == math.huge then return end
    local action = Config.Actions[semantic]
    if not action then return end
    lastAcceptedSerial = serial
    script:SetAttribute("LastAcceptedActionSerial", serial)
    local pending = predicted
    local matched = pending and metadata.sequence == pending.sequence and semantic == pending.name
    if matched then
        local sample = math.clamp(workspace:GetServerTimeNow() - pending.sentServer, .01, 10)
        learnedAckRTT = learnedAckRTT * .75 + sample * .25
        script:SetAttribute("PredictionAckRTT", learnedAckRTT)
        predicted = nil
        script:SetAttribute("PredictionStatus", "Confirmed")
    elseif semantic == "Stagger" or semantic == "GuardBroken" then
        -- Authoritative reactions supersede a speculative input without
        -- treating an unrelated old attack ack as approval of that input.
        predicted = nil
        comboSubmitted = false
        firstR1Input, comboBuffer, comboRequest = nil, nil, nil
        script:SetAttribute("PredictionStatus", "Interrupted")
    end
    local elapsed = math.max(0, workspace:GetServerTimeNow() - started)
    if elapsed &gt;= action.duration or not humanoid or humanoid.Health &lt;= 0 then
        if matched and localAction == pending.localAction then localAction = nil end
        if pending and matched and pending.track and pending.track.IsPlaying then
            if pending.name:sub(1, 4) == "Roll" then pending.track:AdjustSpeed(1)
            else pending.track:Stop(.12) end
        end
        if confirmedAction and confirmedAction.serial &lt; serial then
            if confirmedAction.track and confirmedAction.track.IsPlaying
                and (not predicted or predicted.track ~= confirmedAction.track) then
                if confirmedAction.name:sub(1, 4) == "Roll" then confirmedAction.track:AdjustSpeed(1)
                else confirmedAction.track:Stop(.08) end
            end
            confirmedAction = nil
        end
        script:SetAttribute("AnimationPhaseCorrection", "ExpiredIgnored")
        if firstR1Input and metadata.sequence == firstR1Input.sequence then
            firstR1Input, comboBuffer, comboRequest = nil, nil, nil
            comboSubmitted = false
        end
        return
    end
    local preservePrediction = matched and pending.track and pending.track.IsPlaying
    localAction = {name = semantic, serial = serial, ends = os.clock() + action.duration - elapsed}
    if semantic ~= "SwordR1_1" or not firstR1Input or metadata.sequence ~= firstR1Input.sequence then
        comboSubmitted = false
        firstR1Input, comboBuffer, comboRequest = nil, nil, nil
    end
    local track = playAction(semantic, not preservePrediction)
    confirmedAction = {name = semantic, serial = serial, started = started,
        track = track, seekInitial = not preservePrediction}
    alignConfirmed(confirmedAction)
end)

RunService:BindToRenderStep("CombatFoundationController", Enum.RenderPriority.Character.Value + 1, function(dt)
    if destroyed or not humanoid or humanoid.Health &lt;= 0 or not root then return end
    camera = workspace.CurrentCamera or camera
    if predicted and os.clock() &gt;= predicted.deadline then
        local pending = predicted
        -- The bounded timeout releases input. It never cuts a full roll or
        -- abruptly removes a sword pose; a held preview can finish smoothly.
        if pending.track and pending.track == actionTrack and pending.track.IsPlaying
            and (not confirmedAction or confirmedAction.track ~= pending.track) then
            pending.track:AdjustSpeed(1)
            if localAction == pending.localAction then
                local action = Config.Actions[pending.name]
                local remaining = math.max(0, (action and action.duration or 0) - pending.track.TimePosition)
                localAction = {name = pending.name, ends = os.clock() + remaining}
            end
        elseif localAction == pending.localAction then
            localAction = nil
        end
        predicted = nil
        script:SetAttribute("PredictionStatus", "TimedOut")
    end
    if confirmedAction then alignConfirmed(confirmedAction) end
    dispatchCombo()
    predictMovementRestriction()
    local state = character:GetAttribute("CombatState")
    if rolling() and actionTrack then
        -- Suppress emotes/foreign action tracks while this complete roll is playing.
        for _, other in animator:GetPlayingAnimationTracks() do
            if other ~= actionTrack and other.Priority ~= Enum.AnimationPriority.Core
                and other.Priority.Value &gt;= Enum.AnimationPriority.Action.Value then other:Stop(0) end
        end
    end
    local block = tracks.Block
    if block then
        if state == "Blocking" and not block.IsPlaying then playAction("Block")
        elseif state ~= "Blocking" and block.IsPlaying then block:Stop(.12) end
    end
    if target and not player:GetAttribute("CombatSettingsOpen") then
        local enemyHumanoid = target:FindFirstChildOfClass("Humanoid")
        local enemyRoot = target:FindFirstChild("HumanoidRootPart")
        if not enemyHumanoid or enemyHumanoid.Health &lt;= 0 or not enemyRoot or (enemyRoot.Position - root.Position).Magnitude &gt; Config.TargetLossRange then
            setLock(nil)
        else
            if targetVisible(target) then
                occludedSince = nil
            else
                occludedSince = occludedSince or os.clock()
                if os.clock() - occludedSince &gt; 0.75 then setLock(nil) end
            end
        end
        if target then
            ensureFacing()
            local delta = enemyRoot.Position - root.Position
            local flat = Vector3.new(delta.X, 0, delta.Z)
            if flat.Magnitude &gt; 0.2 then
                local state = character:GetAttribute("CombatState")
                local localBusy = localAction and os.clock() &lt; localAction.ends
                local action = localBusy and localAction.name:sub(1, 5) == "Sword"
                    or (not localBusy and (state == "AttackStartup" or state == "AttackActive" or state == "AttackRecovery"))
                facingAlign.Enabled = not rolling()
                local facingAction = localAction and Config.Actions[localAction.name]
                facingAlign.MaxAngularVelocity = math.rad(action and (facingAction and facingAction.turnRate or Config.Actions.SwordR1_1.turnRate) or 180)
                facingAlign.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
                humanoid.AutoRotate = false
                local desiredPosition = root.Position - flat.Unit * 12 + Vector3.new(0, 5, 0)
                local lookAt = root.Position:Lerp(enemyRoot.Position, 0.45) + Vector3.new(0, 2, 0)
                camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(desiredPosition, lookAt), 1 - math.exp(-dt * 7))
            end
        end
    end
    -- PlayerModule remains the sole source of movement when unlocked. Lock-on
    -- supplies directional Move() only, with gradual input magnitude changes.
    if target then
        local f = (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
        local r = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
        local desired = Vector3.new(r, 0, -f)
        if desired.Magnitude &gt; 1 then desired = desired.Unit end
        moveVector = moveVector:Lerp(desired, 1 - math.exp(-dt * (desired.Magnitude &gt; 0 and 8 or 12)))
        if moveVector.Magnitude &lt; 0.01 then moveVector = Vector3.zero end
        if movementSuppressed or rolling() then moveVector = Vector3.zero end
        humanoid:Move(moveVector, true)
    end
    local idle = tracks.CombatIdle
    if idle then
        local standing = humanoid.MoveDirection.Magnitude &lt; 0.05
            and humanoid.FloorMaterial ~= Enum.Material.Air
        if standing and not idle.IsPlaying then idle:Play(0.15)
        elseif not standing and idle.IsPlaying then idle:Stop(0.15) end
    end
end)

connectLifetime(player.CharacterAdded, bindCharacter)
connectLifetime(player.CharacterAppearanceLoaded, function(loadedCharacter)
    if player.Character == loadedCharacter then bindCharacter(loadedCharacter) end
end)
script.Destroying:Connect(function()
    if destroyed then return end
    -- Best-effort release while the owned client and its remote still exist.
    if remote.Parent then
        pcall(function()
            send("BlockEnd")
            send("SprintEnd")
        end)
    end
    destroyed = true
    characterVersion += 1
    for _, connection in lifetimeConnections do connection:Disconnect() end
    table.clear(lifetimeConnections)
    for _, name in Bindings.Order do ContextActionService:UnbindAction(name) end
    RunService:UnbindFromRenderStep("CombatFoundationController")
    if deathConnection then deathConnection:Disconnect(); deathConnection = nil end
    disconnectTracks()
    clearFacing()
    if type(observer.destroy) == "function" then observer:destroy() end
end)
if player.Character then task.spawn(bindCharacter, player.Character) end
</ProtectedString></Properties></Item><Item class="LocalScript" referent="null"><Properties><string name="Name">CombatSettings</string><ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local root = ReplicatedStorage:WaitForChild("CombatFoundation")
local Bindings = require(root.Shared:WaitForChild("InputBindings"))
local player = Players.LocalPlayer
local remote = root:WaitForChild("CombatSettingsRemote")
local gui = Instance.new("ScreenGui")
gui.Name = "CombatSettings"
gui.ResetOnSpawn = false
gui.DisplayOrder = 30
gui.Parent = player:WaitForChild("PlayerGui")
local function button(parent, text, size, position)
    local item = Instance.new("TextButton")
    item.Size, item.Position = size, position
    item.Text, item.Font, item.TextSize = text, Enum.Font.GothamMedium, 16
    item.BackgroundColor3, item.TextColor3 = Color3.fromRGB(39, 38, 42), Color3.fromRGB(231, 224, 205)
    item.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = item
    item.Parent = parent
    return item
end
local open = button(gui, "Управление", UDim2.fromOffset(130, 36), UDim2.new(1, -146, 0, 18))
open.Name = "OpenSettings"
local panel = Instance.new("Frame")
panel.Size, panel.Position, panel.AnchorPoint = UDim2.fromOffset(430, 452), UDim2.fromScale(.5, .5), Vector2.new(.5, .5)
panel.BackgroundColor3, panel.BorderSizePixel, panel.Visible = Color3.fromRGB(22, 22, 26), 0, false
panel.Parent = gui
panel.Name = "Panel"
local scale = Instance.new("UIScale")
scale.Parent = panel
local function resize()
    local size = gui.AbsoluteSize
    scale.Scale = math.max(.2, math.min(1, (size.X - 24) / 430, (size.Y - 24) / 452))
end
resize()
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
local title = button(panel, "Настройки управления   ×", UDim2.new(1, -24, 0, 40), UDim2.fromOffset(12, 12))
title.Name = "CloseSettings"
local status = Instance.new("TextLabel")
status.Size, status.Position = UDim2.new(1, -28, 0, 54), UDim2.fromOffset(14, 345)
status.BackgroundTransparency, status.TextWrapped = 1, true
status.Font, status.TextSize, status.TextColor3 = Enum.Font.Gotham, 14, Color3.fromRGB(201, 193, 171)
status.Text = "Выберите действие, затем нажмите клавишу. Esc — отмена. WASD зарезервированы для движения."
status.Parent = panel
local current, rows, capturing = table.clone(Bindings.Defaults), {}, nil
local hasLocalEdits = false
local readable = {MouseButton1 = "ЛКМ", MouseButton2 = "ПКМ", MouseButton3 = "Средняя кнопка", Space = "Пробел", LeftShift = "Shift"}
local function render()
    for _, action in Bindings.Order do rows[action].Text = Bindings.Labels[action] .. "    [ " .. (readable[current[action]] or current[action]) .. " ]" end
end
local function apply(values)
    current = values
    for action, name in values do player:SetAttribute("Binding_" .. action, name) end
    render()
end
local saveVersion = 0
local function scheduleSave()
    saveVersion += 1
    local version = saveVersion
    task.delay(.35, function()
        if version == saveVersion then remote:FireServer("Save", current) end
    end)
end
for index, action in Bindings.Order do
    local row = button(panel, "", UDim2.new(1, -28, 0, 35), UDim2.fromOffset(14, 62 + (index - 1) * 40))
    rows[action] = row
    row.Name = action
    row.Activated:Connect(function()
        capturing = action
        status.Text = "Нажмите новую клавишу для «" .. Bindings.Labels[action] .. "». Esc — отмена."
    end)
end
local function setOpen(value)
    capturing = nil
    panel.Visible = value
    player:SetAttribute("CombatSettingsOpen", value)
    resize()
end
open.Activated:Connect(function() setOpen(not panel.Visible) end)
title.Activated:Connect(function() setOpen(false) end)
local reset = button(panel, "Вернуть по умолчанию", UDim2.new(1, -28, 0, 36), UDim2.fromOffset(14, 402))
reset.Name = "ResetBindings"
reset.Activated:Connect(function()
    capturing = nil
    hasLocalEdits = true
    apply(table.clone(Bindings.Defaults))
    scheduleSave()
end)
UserInputService.InputBegan:Connect(function(input)
    if not panel.Visible then return end
    if input.KeyCode == Enum.KeyCode.Escape then setOpen(false); return end
    if not capturing then return end
    if UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
        local mouse = UserInputService:GetMouseLocation()
        for _, object in player.PlayerGui:GetGuiObjectsAtPosition(mouse.X, mouse.Y) do
            if object:IsA("GuiButton") then return end
        end
    end
    local name = if input.KeyCode ~= Enum.KeyCode.Unknown then input.KeyCode.Name else input.UserInputType.Name
    if not Bindings.resolve(name) then status.Text = "Эта клавиша недоступна. Выберите другую."; return end
    for action, existing in current do
        if action ~= capturing and name == existing then status.Text = "Клавиша уже назначена: " .. Bindings.Labels[action]; return end
    end
    local values = table.clone(current)
    values[capturing] = name
    capturing = nil
    hasLocalEdits = true
    apply(values)
    status.Text = "Назначение применено. Сохранение…"
    scheduleSave()
end)
remote.OnClientEvent:Connect(function(kind, values)
    if kind == "Loaded" then
        local valid = Bindings.validate(values)
        if valid and not hasLocalEdits then apply(valid) end
    elseif kind == "Saved" then status.Text = "Настройки сохранены."
    elseif kind == "Unavailable" then status.Text = "Назначения работают в этой сессии. Постоянное сохранение сейчас недоступно." end
end)
apply(current)
remote:FireServer("Load")
</ProtectedString></Properties></Item></Item><Item class="RemoteEvent" referent="null"><Properties><string name="Name">CombatRemote</string></Properties></Item></Item></roblox>